#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACK="$ROOT/agent-skills"

usage() {
  cat <<'EOF'
Usage:
  bin/dev-flow list
  bin/dev-flow show <alias-or-skill>
  bin/dev-flow path <alias-or-skill>
  bin/dev-flow command <idea|pm|agent|spec|design|plan|build|test|review|ship|debug|ui|api|security|code-simplify>
  bin/dev-flow agent <code-reviewer|product-designer|test-engineer|security-auditor|ui-quality-reviewer>
  bin/dev-flow refs
  bin/dev-flow install <codex|claude-code|gemini|openclaw|opencode> [--scope project|user] [--dest path]
  bin/dev-flow init <project-name>
  bin/dev-flow status <project-name>
  bin/dev-flow phase <project-name> <idea|pm|agent|spec|design|plan|build|test|review|ship> [task] [--force]
  bin/dev-flow next <project-name>
  bin/dev-flow verify-phase <project-name> <idea|pm|agent|spec|design|plan|build|test|review|ship>
  bin/dev-flow pdca-check <project-name>
  bin/dev-flow ship-check <project-name>
  bin/dev-flow reference-check <project-name> [--required|--delegated]
  bin/dev-flow design-check <project-name> [--allow-no-reference]
  bin/dev-flow qa-check <project-name>
  bin/dev-flow visual-check <project-name>
  bin/dev-flow check <project-name>
  bin/dev-flow package-adapters [output-dir]

Aliases:
  idea      -> idea-refine
  spec      -> spec-driven-development
  design    -> design-flow
  plan      -> planning-and-task-breakdown
  build     -> incremental-implementation
  test      -> test-driven-development
  review    -> code-review-and-quality
  debug     -> debugging-and-error-recovery
  ui        -> frontend-ui-engineering
  api       -> api-and-interface-design
  security  -> security-and-hardening
  ship      -> shipping-and-launch
  pm        -> pm-flow
  agent     -> agent-flow

Applicability:
  Optional phases are controlled by work/<project-name>/.dev-flow/applicability.env.
  Set PM_FLOW, AGENT_FLOW, UI_FLOW, UI_REFERENCES, UI_IMAGEGEN, or UI_MOCKUPS to auto, required, delegated, or disabled.
EOF
}

project_path() {
  local name="${1:-}"
  if [[ -z "$name" || "$name" == *"/"* || "$name" == "." || "$name" == ".." ]]; then
    echo "Invalid project name: ${name:-<missing>}" >&2
    echo "Use a simple folder name, for example: hotel-agent-workbench" >&2
    exit 1
  fi
  echo "$ROOT/work/$name"
}

state_path() {
  echo "$(project_path "${1:-}")/.dev-flow/state.env"
}

applicability_path() {
  echo "$(project_path "${1:-}")/.dev-flow/applicability.env"
}

require_project() {
  local dir
  dir="$(project_path "${1:-}")"
  if [[ ! -d "$dir" ]]; then
    echo "Unknown project: ${1:-<missing>}" >&2
    echo "Create it first with: bin/dev-flow init <project-name>" >&2
    exit 1
  fi
}

load_project_state() {
  local state
  state="$(state_path "${1:-}")"
  if [[ -f "$state" ]]; then
    # shellcheck disable=SC1090
    source "$state"
  fi
  CURRENT_PHASE="${CURRENT_PHASE:-idea}"
  CURRENT_TASK="${CURRENT_TASK:-Refine the initial idea}"
  BLOCKERS="${BLOCKERS:-none}"
  LAST_VERIFICATION="${LAST_VERIFICATION:-not run}"
}

is_valid_phase() {
  case "${1:-}" in
    idea|pm|agent|spec|design|plan|build|test|review|ship) return 0 ;;
    *) return 1 ;;
  esac
}

write_project_state() {
  local project="$1"
  local phase="$2"
  local task="$3"
  local blockers="$4"
  local verification="$5"
  local state
  state="$(state_path "$project")"
  mkdir -p "$(dirname "$state")"
  {
    printf 'PROJECT_NAME=%q\n' "$project"
    printf 'CURRENT_PHASE=%q\n' "$phase"
    printf 'CURRENT_TASK=%q\n' "$task"
    printf 'BLOCKERS=%q\n' "$blockers"
    printf 'LAST_VERIFICATION=%q\n' "$verification"
  } > "$state"
}

write_if_missing() {
  local path="$1"
  local content="$2"
  if [[ ! -e "$path" ]]; then
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$content" > "$path"
  fi
}

next_prompt_for_phase() {
  case "${1:-idea}" in
    idea)
      echo "Use local flow: idea"
      echo "Goal: refine the rough idea and save the result under work/<project>/ideas/."
      ;;
    pm)
      echo "Use local flow: pm"
      echo "Goal: turn product intent into PRD, user stories, metrics, and acceptance criteria under work/<project>/product/."
      ;;
    agent)
      echo "Use local flow: agent"
      echo "Goal: design an agent product workflow: goals, tools, permissions, state machine, handoffs, failure recovery, and evals."
      ;;
    spec)
      echo "Use local flow: spec"
      echo "Goal: turn the approved idea into work/<project>/specs/SPEC.md."
      ;;
    design)
      echo "Use local flow: design"
      echo "Goal: define UX, interaction, visual, and platform requirements under work/<project>/design/."
      echo "Before designing customer-facing UI, run: bin/dev-flow reference-check <project> --required"
      echo "For UI work, generate 1-N imagegen layout/state boards per screen before planning or implementation."
      ;;
    plan)
      echo "Use local flow: plan"
      echo "Goal: break the approved spec/design into verifiable tasks under work/<project>/tasks/."
      echo "Update tasks/PDCA.md with the Plan intent, acceptance evidence, and next checkpoint."
      ;;
    build)
      echo "Use local flow: build"
      echo "Goal: implement the next task slice, then run bin/dev-flow check <project>."
      echo "For UI work, confirm bin/dev-flow design-check <project> passes before writing code."
      echo "Update tasks/PDCA.md with the Do evidence after each implementation slice."
      ;;
    test)
      echo "Use local flow: test"
      echo "Goal: add or run proof for the implemented slice."
      echo "Update tasks/PDCA.md with the Check evidence: verification, functional tests, monkey tests, and visual comparison when UI applies."
      ;;
    review)
      echo "Use local flow: review"
      echo "Goal: review correctness, readability, architecture, security, and performance."
      ;;
    ship)
      echo "Use local flow: ship"
      echo "Goal: prepare launch notes, rollback notes, and release evidence."
      echo "Before delivery, run: bin/dev-flow pdca-check <project>"
      ;;
    *)
      echo "Unknown phase: ${1:-<missing>}"
      echo "Valid phases: idea, pm, agent, spec, design, plan, build, test, review, ship"
      ;;
  esac
}

mime_type_for_file() {
  local path="$1"
  file --mime-type -b "$path" 2>/dev/null || file -bI "$path" 2>/dev/null | sed 's/;.*//'
}

is_supported_artifact() {
  local path="$1"
  local kind="${2:-image}"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$kind:$mime" in
      image:image/*|image:application/pdf) return 0 ;;
      cut:image/*|cut:application/pdf|cut:text/xml|cut:application/xml) return 0 ;;
      reference:image/*|reference:application/pdf|reference:application/json) return 0 ;;
    esac
    case "$kind:$path" in
      reference:*.[Ff][Ii][Gg]) return 0 ;;
    esac
    return 1
  fi
  return 0
}

count_supported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_unsupported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if ! is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_reference_assets() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/references" "$dir/design/mocks" "$dir/design/screenshots"
}

count_reference_links() {
  local path="$1/design/reference-links.md"
  if [[ ! -f "$path" ]]; then
    echo 0
    return
  fi
  awk '
    /^## References/ { found = 1; next }
    found && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#/ && $0 !~ /^<!--/ { count++ }
    END { print count + 0 }
  ' "$path"
}

count_visual_screenshots() {
  local dir="$1"
  count_supported_artifacts image "$dir/reviews/visual-screenshots"
}

count_design_mockups() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/mocks"
}

count_imagegen_artifacts() {
  local dir="$1"
  count_supported_artifacts image "$dir/design/imagegen"
}

is_final_imagegen_artifact() {
  local path="$1"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$mime" in
      image/svg+xml|text/xml|application/xml) return 1 ;;
      image/*|application/pdf) return 0 ;;
    esac
    return 1
  fi
  case "$path" in
    *.[Pp][Nn][Gg]|*.[Jj][Pp][Gg]|*.[Jj][Pp][Ee][Gg]|*.[Ww][Ee][Bb][Pp]|*.[Gg][Ii][Ff]|*.[Hh][Ee][Ii][Cc]|*.[Pp][Dd][Ff]) return 0 ;;
  esac
  return 1
}

count_final_imagegen_artifacts() {
  local dir="$1"
  local existing=()
  local candidate
  for candidate in "$dir/design/imagegen"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_final_imagegen_artifact "$path"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

trim_md_cell() {
  printf '%s' "${1:-}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/^`//; s/`$//'
}

has_md_heading() {
  local path="$1"
  local heading="$2"
  [[ -f "$path" ]] || return 1
  grep -Eiq "^##[[:space:]]+${heading}([[:space:]]*$|[[:space:]]|:)" "$path"
}

has_md_heading_alias() {
  local path="$1"
  local aliases="$2"
  local alias
  local -a heading_aliases
  IFS='|' read -r -a heading_aliases <<< "$aliases"
  for alias in "${heading_aliases[@]}"; do
    if has_md_heading "$path" "$alias"; then
      return 0
    fi
  done
  return 1
}

check_required_headings() {
  local path="$1"
  local label="$2"
  shift 2
  local heading failures
  failures=0
  for heading in "$@"; do
    if ! has_md_heading "$path" "$heading"; then
      echo "Missing required section in $label: ## $heading" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

check_required_heading_aliases() {
  local path="$1"
  local label="$2"
  shift 2
  local aliases display failures
  failures=0
  for aliases in "$@"; do
    display="${aliases%%|*}"
    if ! has_md_heading_alias "$path" "$aliases"; then
      echo "Missing required section in $label: ## $display" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

pdca_section_has_evidence() {
  local path="$1"
  local heading="$2"
  [[ -f "$path" ]] || return 1
  awk -v target="$heading" '
    BEGIN { found = 0; in_section = 0 }
    /^##[[:space:]]+/ {
      current = $0
      sub(/^##[[:space:]]+/, "", current)
      gsub(/[[:space:]]+$/, "", current)
      in_section = (tolower(current) == tolower(target))
      next
    }
    in_section {
      line = $0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (line == "" || line ~ /^<!--/) next
      if (line ~ /^[^:]+:[[:space:]]*$/) next
      found = 1
    }
    END { exit found ? 0 : 1 }
  ' "$path"
}

check_design_package_structure() {
  local dir="$1"
  local failures
  failures=0
  check_required_heading_aliases "$dir/design/DESIGN.md" "design/DESIGN.md" \
    "UX Problem|UX 问题" "Recommended Direction|推荐方向" "Alternatives Considered|备选方案" \
    "Information Architecture|信息架构" "Interaction Model|交互模型" "Visual System|视觉系统" \
    "Design Artifacts|设计产物" "Build Implications|实施影响" || failures=$((failures + 1))
  check_required_heading_aliases "$dir/design/VISUAL_SYSTEM.md" "design/VISUAL_SYSTEM.md" \
    "Reference Influence|参考影响" "Palette|色彩" "Typography|字体|字体与文字|排版" \
    "Spacing and Layout|间距与布局" "Components and Motion|组件与动效|组件" \
    "Forbidden Patterns|禁止模式|禁用模式" || failures=$((failures + 1))
  check_screen_acceptance_structure "$dir" || failures=$((failures + 1))
  [[ "$failures" -eq 0 ]]
}

required_design_screens() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 0
  awk '
    /^##[[:space:]]+/ {
      sub(/^##[[:space:]]+/, "")
      gsub(/[[:space:]]+$/, "")
      if ($0 != "") print
    }
  ' "$path"
}

is_project_imagegen_board_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  case "$saved_path" in
    design/imagegen/*|./design/imagegen/*)
      [[ "$full_path" == "$dir/"* ]]
      ;;
    /*)
      [[ "$full_path" == "$dir/design/imagegen/"* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

screen_has_final_imagegen_board() {
  local dir="$1"
  local screen="$2"
  local prompts="$dir/design/imagegen-prompts.md"
  local line screen_cell path_cell screen_name saved_path full_path
  [[ -f "$prompts" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    IFS='|' read -r _ screen_cell _ _ path_cell _ <<< "$line"
    screen_name="$(trim_md_cell "$screen_cell")"
    [[ "$screen_name" == "$screen" ]] || continue
    saved_path="$(trim_md_cell "$path_cell")"
    [[ -n "$saved_path" ]] || continue
    case "$saved_path" in
      /*) full_path="$saved_path" ;;
      *) full_path="$dir/$saved_path" ;;
    esac
    if is_project_imagegen_board_path "$dir" "$saved_path" "$full_path" && is_final_imagegen_artifact "$full_path"; then
      return 0
    fi
  done < "$prompts"
  return 1
}

check_screen_acceptance_structure() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 1
  awk '
    function flush() {
      if (screen == "") return
      if (!states || !breakpoints || !boards || !visual || !accessibility) {
        print "Incomplete screen acceptance section: " screen " (requires Required states, Breakpoints, Required imagegen boards, Visual acceptance, and Accessibility acceptance)." > "/dev/stderr"
        failures++
      }
    }
    /^##[[:space:]]+/ {
      flush()
      screen = $0
      sub(/^##[[:space:]]+/, "", screen)
      gsub(/[[:space:]]+$/, "", screen)
      states = breakpoints = boards = visual = accessibility = 0
      seen = 1
      next
    }
    screen != "" {
      if ($0 ~ /(Required states|必备状态)[：:]/) states = 1
      if ($0 ~ /(Breakpoints|断点)[：:]/) breakpoints = 1
      if ($0 ~ /(Required imagegen boards|高保真参考图|设计板)[：:]/) boards = 1
      if ($0 ~ /(Visual acceptance|视觉验收)[：:]/) visual = 1
      if ($0 ~ /(Accessibility acceptance|无障碍验收)[：:]/) accessibility = 1
    }
    END {
      flush()
      if (!seen) {
        print "Missing screen acceptance headings: add one or more ## Screen Name sections to design/SCREEN_ACCEPTANCE.md." > "/dev/stderr"
        failures++
      }
      exit failures
    }
  ' "$path"
}

check_imagegen_screen_coverage() {
  local dir="$1"
  local missing=0
  local required=0
  local screen
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! screen_has_final_imagegen_board "$dir" "$screen"; then
      echo "Missing final imagegen board for screen: $screen (add a raster/PDF path for this screen in design/imagegen-prompts.md)." >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  if [[ "$required" -eq 0 ]]; then
    echo "Missing screen acceptance headings: add one or more '## Screen Name' sections to design/SCREEN_ACCEPTANCE.md." >&2
    return 1
  fi
  [[ "$missing" -eq 0 ]]
}

check_visual_comparison_screen_coverage() {
  local dir="$1"
  local path="$dir/reviews/VISUAL_COMPARISON.md"
  local missing screen required
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! grep -Fq "$screen" "$path"; then
      echo "Missing visual comparison coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

plan_references_design_contract() {
  local dir="$1"
  local path="$dir/tasks/PLAN.md"
  [[ -f "$path" ]] || return 1
  grep -Eiq 'DESIGN\.md|VISUAL_SYSTEM\.md|SCREEN_ACCEPTANCE\.md|imagegen|design/imagegen|VISUAL_COMPARISON' "$path"
}

count_invalid_imagegen_artifacts() {
  local dir="$1"
  count_unsupported_artifacts image "$dir/design/imagegen"
}

count_cut_assets() {
  local dir="$1"
  count_supported_artifacts cut "$dir/design/cut-assets"
}

has_content() {
  local path="$1"
  [[ -s "$path" ]] && [[ "$(wc -l < "$path" | tr -d ' ')" -ge 5 ]]
}

load_project_applicability() {
  local path
  PM_FLOW="auto"
  AGENT_FLOW="auto"
  UI_FLOW="required"
  UI_REFERENCES="required"
  UI_IMAGEGEN="required"
  UI_MOCKUPS="auto"
  GIT_CHECKPOINTS="auto"
  path="$(applicability_path "${1:-}")"
  if [[ -f "$path" ]]; then
    # shellcheck disable=SC1090
    source "$path"
  fi
}

setting_enabled() {
  case "${1:-}" in
    required|enabled|true|yes|1) return 0 ;;
    *) return 1 ;;
  esac
}

setting_disabled() {
  case "${1:-}" in
    disabled|false|no|0|skip|off) return 0 ;;
    *) return 1 ;;
  esac
}

setting_delegated() {
  case "${1:-}" in
    delegated|delegate|user-delegated|visual-direction-delegated) return 0 ;;
    *) return 1 ;;
  esac
}

references_required_loaded() {
  setting_disabled "$UI_REFERENCES" && return 1
  setting_delegated "$UI_REFERENCES" && return 1
  return 0
}

references_required() {
  load_project_applicability "$1"
  references_required_loaded
}

has_phase_artifact() {
  local project="$1"
  local phase="$2"
  local dir
  dir="$(project_path "$project")"
  case "$phase" in
    pm)
      [[ -s "$dir/product/PRD.md" || -s "$dir/product/USER_STORIES.md" || -s "$dir/product/ACCEPTANCE.md" || -s "$dir/product/METRICS.md" ]]
      ;;
    agent)
      [[ -s "$dir/agent/AGENT_SPEC.md" || -s "$dir/agent/WORKFLOW.md" || -s "$dir/agent/TOOLS_AND_PERMISSIONS.md" || -s "$dir/agent/PROMPTS_AND_SKILLS.md" || -s "$dir/agent/EVALS.md" || -s "$dir/agent/FAILURE_RECOVERY.md" || -s "$dir/agent/OPERATIONS.md" ]]
      ;;
    design)
      [[ -s "$dir/design/DESIGN.md" || -s "$dir/design/VISUAL_SYSTEM.md" || -s "$dir/design/SCREEN_ACCEPTANCE.md" ]] && return 0
      [[ "$(count_reference_assets "$dir")" -gt 0 || "$(count_reference_links "$dir")" -gt 0 || "$(count_design_mockups "$dir")" -gt 0 || "$(count_imagegen_artifacts "$dir")" -gt 0 ]]
      ;;
    *)
      return 1
      ;;
  esac
}

phase_is_applicable() {
  local project="$1"
  local phase="$2"
  load_project_applicability "$project"
  case "$phase" in
    idea|spec|plan|build|test|review|ship)
      return 0
      ;;
    pm)
      setting_disabled "$PM_FLOW" && return 1
      setting_enabled "$PM_FLOW" && return 0
      has_phase_artifact "$project" pm
      ;;
    agent)
      setting_disabled "$AGENT_FLOW" && return 1
      setting_enabled "$AGENT_FLOW" && return 0
      has_phase_artifact "$project" agent
      ;;
    design)
      setting_disabled "$UI_FLOW" && return 1
      setting_enabled "$UI_FLOW" && return 0
      has_phase_artifact "$project" design
      ;;
    *)
      return 1
      ;;
  esac
}

phase_index() {
  case "${1:-}" in
    idea) echo 0 ;;
    pm) echo 1 ;;
    agent) echo 2 ;;
    spec) echo 3 ;;
    design) echo 4 ;;
    plan) echo 5 ;;
    build) echo 6 ;;
    test) echo 7 ;;
    review) echo 8 ;;
    ship) echo 9 ;;
    *) echo -1 ;;
  esac
}

verify_prior_applicable_phases() {
  local project="$1"
  local phase="$2"
  local target_idx candidate candidate_idx failures
  target_idx="$(phase_index "$phase")"
  failures=0
  for candidate in idea pm agent spec design plan build test review ship; do
    candidate_idx="$(phase_index "$candidate")"
    if [[ "$candidate_idx" -ge 0 && "$candidate_idx" -lt "$target_idx" ]]; then
      if phase_is_applicable "$project" "$candidate"; then
        echo "Verifying prior phase before entering $phase: $candidate"
        if ! verify_phase_impl "$project" "$candidate"; then
          failures=$((failures + 1))
        fi
      fi
    fi
  done
  [[ "$failures" -eq 0 ]]
}

record_verification() {
  local project="$1"
  local text="$2"
  load_project_state "$project"
  write_project_state "$project" "$CURRENT_PHASE" "$CURRENT_TASK" "$BLOCKERS" "$text"
}

set_project_applicability() {
  local project="$1"
  local key="$2"
  local value="$3"
  local path tmp
  path="$(applicability_path "$project")"
  mkdir -p "$(dirname "$path")"
  tmp="$path.tmp"
  if [[ -f "$path" && "$(grep -c "^$key=" "$path" || true)" -gt 0 ]]; then
    awk -v key="$key" -v value="$value" '
      $0 ~ "^" key "=" { print key "=\"" value "\""; next }
      { print }
    ' "$path" > "$tmp"
    mv "$tmp" "$path"
  else
    printf '%s="%s"\n' "$key" "$value" >> "$path"
  fi
}

require_content_file() {
  local dir="$1"
  local rel="$2"
  if ! has_content "$dir/$rel"; then
    echo "Missing or too thin: $rel" >&2
    return 1
  fi
}

require_any_file() {
  local dir="$1"
  local label="$2"
  shift 2
  local pattern
  for pattern in "$@"; do
    if find "$dir" -path "$dir/$pattern" -type f 2>/dev/null | grep -q .; then
      return 0
    fi
  done
  echo "Missing evidence: $label" >&2
  return 1
}

visual_score() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  sed -nE 's/.*Overall score:[[:space:]]*([0-9][0-9]?[0-9]?)\/100.*/\1/p' "$path" | head -n 1
}

qa_exception_recorded() {
  local dir="$1"
  [[ -f "$dir/reviews/EXCEPTION.md" || -f "$dir/reviews/BLOCKED_FLOW.md" ]]
}

verify_phase_impl() {
  local project="$1"
  local phase="$2"
  require_project "$project"
  if ! is_valid_phase "$phase"; then
    echo "Invalid phase: ${phase:-<missing>}" >&2
    return 1
  fi
  local dir failures assets links mockups imagegen_assets final_imagegen_assets screenshots java_sources
  dir="$(project_path "$project")"
  failures=0
  case "$phase" in
    idea)
      require_content_file "$dir" "ideas/idea-brief.md" || failures=$((failures + 1))
      ;;
    pm)
      for file in product/PRD.md product/USER_STORIES.md product/ACCEPTANCE.md product/METRICS.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      ;;
    agent)
      for file in agent/AGENT_SPEC.md agent/WORKFLOW.md agent/TOOLS_AND_PERMISSIONS.md agent/PROMPTS_AND_SKILLS.md agent/EVALS.md agent/FAILURE_RECOVERY.md agent/OPERATIONS.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      ;;
    spec)
      require_content_file "$dir" "specs/SPEC.md" || failures=$((failures + 1))
      ;;
    design)
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      mockups="$(count_design_mockups "$dir")"
      imagegen_assets="$(count_imagegen_artifacts "$dir")"
      final_imagegen_assets="$(count_final_imagegen_artifacts "$dir")"
      if references_required "$project" && [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or reference links before design verification." >&2
        failures=$((failures + 1))
      fi
      load_project_applicability "$project"
      if setting_enabled "$UI_IMAGEGEN"; then
        require_content_file "$dir" "design/imagegen-prompts.md" || failures=$((failures + 1))
        if [[ "$(count_invalid_imagegen_artifacts "$dir")" -gt 0 ]]; then
          echo "Invalid imagegen artifact(s): files under design/imagegen/ must be real non-empty image/PDF files, not text placeholders." >&2
          failures=$((failures + 1))
        fi
        if [[ "$imagegen_assets" -eq 0 ]]; then
          echo "Missing imagegen design boards: generate 1-N layout/state images per UI screen under design/imagegen/ before implementation planning." >&2
          failures=$((failures + 1))
        fi
        if [[ "$final_imagegen_assets" -eq 0 ]]; then
          echo "Missing final imagegen design board: SVG/Mermaid/code-native drafts are allowed as layout references, but design/imagegen/ must include at least one raster image or PDF generated by imagegen." >&2
          failures=$((failures + 1))
        fi
        if ! check_imagegen_screen_coverage "$dir"; then
          failures=$((failures + 1))
        fi
      fi
      if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
        echo "Missing design mockups: add image/SVG/PDF/Figma artifacts under design/mocks/." >&2
        failures=$((failures + 1))
      fi
      for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      if ! check_design_package_structure "$dir"; then
        failures=$((failures + 1))
      fi
      ;;
    plan)
      for file in tasks/PLAN.md tasks/quality-gates.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      if phase_is_applicable "$project" design && ! plan_references_design_contract "$dir"; then
        echo "Missing design handoff in tasks/PLAN.md: reference DESIGN.md, SCREEN_ACCEPTANCE.md, imagegen boards, or visual comparison criteria before UI implementation." >&2
        failures=$((failures + 1))
      fi
      ;;
    build)
      require_any_file "$dir" "implemented source under apps/ or packages/" "apps/*" "packages/*" || failures=$((failures + 1))
      if [[ -d "$dir/apps/android" ]]; then
        [[ -f "$dir/apps/android/settings.gradle.kts" || -f "$dir/apps/android/settings.gradle" ]] || { echo "Missing Android settings.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$dir/apps/android/app/build.gradle.kts" || -f "$dir/apps/android/app/build.gradle" ]] || { echo "Missing Android app build.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$dir/apps/android/app/src/main/AndroidManifest.xml" ]] || { echo "Missing AndroidManifest.xml." >&2; failures=$((failures + 1)); }
        java_sources="$(find "$dir/apps/android/app/src/main" -type f \( -name '*.java' -o -name '*.kt' \) 2>/dev/null | wc -l | tr -d ' ')"
        [[ "$java_sources" -gt 0 ]] || { echo "Missing Android Java/Kotlin sources." >&2; failures=$((failures + 1)); }
      fi
      ;;
    test)
      if [[ -d "$dir/apps/android" ]] && { ! command -v java >/dev/null 2>&1 || ! command -v gradle >/dev/null 2>&1; }; then
        require_content_file "$dir" "reviews/BLOCKED_BUILD.md" || failures=$((failures + 1))
      else
        if [[ ! -f "$dir/reviews/VERIFICATION.md" && ! -f "$dir/reviews/BLOCKED_BUILD.md" ]]; then
          echo "Missing verification evidence: add reviews/VERIFICATION.md or reviews/BLOCKED_BUILD.md." >&2
          failures=$((failures + 1))
        fi
      fi
      ;;
    review)
      require_content_file "$dir" "reviews/REVIEW.md" || failures=$((failures + 1))
      ;;
    ship)
      require_content_file "$dir" "ship/LAUNCH.md" || failures=$((failures + 1))
      ;;
  esac
  if [[ "$failures" -gt 0 ]]; then
    echo "Phase verification failed: $project/$phase" >&2
    return 1
  fi
  echo "Phase verification passed: $project/$phase"
}

qa_check_impl() {
  local project="$1"
  local dir failures mockups imagegen_assets final_imagegen_assets screenshots score
  require_project "$project"
  dir="$(project_path "$project")"
  failures=0
  for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md reviews/VISUAL_COMPARISON.md; do
    if ! has_content "$dir/$file"; then
      echo "Missing or too thin: $file" >&2
      failures=$((failures + 1))
    fi
  done
  mockups="$(count_design_mockups "$dir")"
  imagegen_assets="$(count_imagegen_artifacts "$dir")"
  final_imagegen_assets="$(count_final_imagegen_artifacts "$dir")"
  screenshots="$(count_visual_screenshots "$dir")"
  load_project_applicability "$project"
  if setting_enabled "$UI_IMAGEGEN"; then
    if ! has_content "$dir/design/imagegen-prompts.md"; then
      echo "Missing or too thin: design/imagegen-prompts.md" >&2
      failures=$((failures + 1))
    fi
    if [[ "$(count_invalid_imagegen_artifacts "$dir")" -gt 0 ]]; then
      echo "Invalid imagegen artifact(s): files under design/imagegen/ must be real non-empty image/PDF files, not text placeholders." >&2
      failures=$((failures + 1))
    fi
    if [[ "$imagegen_assets" -eq 0 ]]; then
      echo "Missing imagegen UI boards under design/imagegen/." >&2
      failures=$((failures + 1))
    fi
    if [[ "$final_imagegen_assets" -eq 0 ]]; then
      echo "Missing final imagegen UI board under design/imagegen/: SVG/Mermaid/code-native drafts do not satisfy the imagegen gate without a raster image or PDF output." >&2
      failures=$((failures + 1))
    fi
    if ! check_imagegen_screen_coverage "$dir"; then
      failures=$((failures + 1))
    fi
  fi
  if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
    echo "Missing design mockup evidence under design/mocks/." >&2
    failures=$((failures + 1))
  fi
  score="$(visual_score "$dir/reviews/VISUAL_COMPARISON.md" || true)"
  if [[ -z "$score" ]]; then
    echo "Missing visual comparison score: add 'Overall score: N/100' to reviews/VISUAL_COMPARISON.md." >&2
    failures=$((failures + 1))
  elif [[ "$score" -gt 100 ]]; then
    echo "Visual comparison score out of range: $score/100." >&2
    failures=$((failures + 1))
  elif [[ "$score" -lt 90 ]]; then
    echo "Visual comparison score too low: $score/100, expected at least 90/100 for high-fidelity UI delivery." >&2
    failures=$((failures + 1))
  fi
  check_required_headings "$dir/reviews/VISUAL_COMPARISON.md" "reviews/VISUAL_COMPARISON.md" \
    "Compared Inputs" "Screen Fidelity Matrix" "Score Breakdown" "Differences" "Decision" || failures=$((failures + 1))
  if ! check_visual_comparison_screen_coverage "$dir"; then
    failures=$((failures + 1))
  fi
  if qa_exception_recorded "$dir"; then
    if [[ "$screenshots" -eq 0 && ! -s "$dir/reviews/BLOCKED_SCREENSHOT.md" ]]; then
      echo "Exception or blocked-flow record found; add screenshot evidence under reviews/visual-screenshots/ or document why capture is impossible in reviews/BLOCKED_SCREENSHOT.md." >&2
      failures=$((failures + 1))
    fi
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "QA check failed for $project." >&2
    return 1
  fi
  echo "QA check passed for $project with $imagegen_assets imagegen UI board(s), visual score ${score:-n/a}/100, functional test evidence, and monkey test evidence."
  if [[ "$screenshots" -eq 0 ]]; then
    echo "No exception or blocked flow recorded; runtime screenshots were not required."
  else
    echo "Runtime screenshot artifacts found: $screenshots."
  fi
}

pdca_check_impl() {
  local project="$1"
  local dir path failures
  require_project "$project"
  dir="$(project_path "$project")"
  path="$dir/tasks/PDCA.md"
  failures=0

  require_content_file "$dir" "tasks/PDCA.md" || failures=$((failures + 1))
  if [[ -f "$path" ]]; then
    check_required_headings "$path" "tasks/PDCA.md" "Current Cycle" "Plan" "Do" "Check" "Act" || failures=$((failures + 1))
    if ! pdca_section_has_evidence "$path" "Current Cycle"; then
      echo "Missing Current Cycle evidence in tasks/PDCA.md: fill the section with cycle scope, owner, date, or checkpoint." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Plan"; then
      echo "Missing Plan section evidence in tasks/PDCA.md: fill the section with concrete objective, source artifacts, acceptance criteria, or gates." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Do"; then
      echo "Missing Do section evidence in tasks/PDCA.md: fill the section with implemented slices, changed areas, or build artifacts." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Check"; then
      echo "Missing Check section evidence in tasks/PDCA.md: fill the section with verification, functional, monkey, or visual QA results." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Act"; then
      echo "Missing Act section evidence in tasks/PDCA.md: fill the section with decision, standardization, follow-up, or rollback notes." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'cycle|scope|SPEC\.md|DESIGN\.md|SCREEN_ACCEPTANCE\.md|PLAN\.md|acceptance|objective|hypothesis|quality gate|checkpoint' "$path"; then
      echo "Missing Plan evidence in tasks/PDCA.md: cite objective, acceptance criteria, source artifacts, or quality gates." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'build|implementation|implemented|task|slice|apps/|packages/|changed|commit' "$path"; then
      echo "Missing Do evidence in tasks/PDCA.md: record implementation slices, changed areas, or build artifacts." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'VERIFICATION\.md|FUNCTIONAL_TEST\.md|MONKEY_TEST\.md|VISUAL_COMPARISON\.md|test|qa-check|ship-check|score|verification' "$path"; then
      echo "Missing Check evidence in tasks/PDCA.md: record verification, functional tests, monkey tests, and QA evidence." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'decision|standardize|iterate|rollback|follow-up|next cycle|adjust|lesson' "$path"; then
      echo "Missing Act evidence in tasks/PDCA.md: record the decision, follow-up, rollback, standardization, or next-cycle adjustment." >&2
      failures=$((failures + 1))
    fi
    if phase_is_applicable "$project" design && ! grep -Eiq 'VISUAL_COMPARISON\.md|visual comparison|imagegen|90/100|score' "$path"; then
      echo "Missing UI Check evidence in tasks/PDCA.md: link imagegen boards and visual comparison score for customer-facing UI." >&2
      failures=$((failures + 1))
    fi
  fi

  if [[ "$failures" -gt 0 ]]; then
    echo "PDCA check failed for $project." >&2
    return 1
  fi
  echo "PDCA check passed for $project."
}

ship_check_impl() {
  local project="$1"
  local phase failures
  failures=0
  for phase in idea pm agent spec design plan build test review ship; do
    if ! phase_is_applicable "$project" "$phase"; then
      echo "Skipping non-applicable phase: $project/$phase"
      continue
    fi
    if ! verify_phase_impl "$project" "$phase"; then
      failures=$((failures + 1))
    fi
  done
  if [[ "$failures" -gt 0 ]]; then
    echo "Ship check failed for $project with $failures failing phase(s)." >&2
    return 1
  fi
  if ! (cd "$(project_path "$project")" && ./bin/check); then
    echo "Project default check failed for $project." >&2
    return 1
  fi
  if phase_is_applicable "$project" design; then
    if ! qa_check_impl "$project"; then
      echo "Project QA check failed for $project." >&2
      return 1
    fi
  fi
  if ! pdca_check_impl "$project"; then
    echo "Project PDCA check failed for $project." >&2
    return 1
  fi
  echo "Ship check passed for $project."
}

copy_skill_dirs() {
  local target="$1"
  local skill_dir
  local name
  mkdir -p "$target"
  if [[ -d "$PACK/skills" ]]; then
    for skill_dir in "$PACK/skills"/*; do
      [[ -d "$skill_dir" ]] || continue
      name="$(basename "$skill_dir")"
      mkdir -p "$target/$name"
      cp -R "$skill_dir/." "$target/$name/"
    done
  fi
}

copy_agent_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/agents" ]]; then
    find "$PACK/agents" -mindepth 1 -maxdepth 1 -type f -name '*.md' -exec cp {} "$target" \;
  fi
}

copy_reference_dirs() {
  local target="$1"
  if [[ -d "$PACK/references" ]]; then
    mkdir -p "$target/references"
    cp -R "$PACK/references/." "$target/references/"
  fi
}

copy_command_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/commands" ]]; then
    cp -R "$PACK/commands/." "$target/"
  fi
}

clean_metadata() {
  local target="$1"
  [[ -d "$target" ]] || return 0
  find "$target" \( -name '.DS_Store' -o -name '@eaDir' -o -name '*SynoEAStream' -o -name '*SynoResource' \) -prune -exec rm -rf {} + 2>/dev/null || true
}

copy_claude_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.claude/commands" ]]; then
    cp -R "$PACK/.claude/commands/." "$target/"
  fi
}

copy_gemini_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.gemini/commands" ]]; then
    cp -R "$PACK/.gemini/commands/." "$target/"
  fi
}

embed_shared_references() {
  local skills_dir="$1"
  local skill_dir
  [[ -d "$skills_dir" && -d "$PACK/references" ]] || return 0
  for skill_dir in "$skills_dir"/*; do
    [[ -d "$skill_dir" ]] || continue
    mkdir -p "$skill_dir/references"
    cp -R "$PACK/references/." "$skill_dir/references/"
  done
}

skill_name() {
  case "${1:-}" in
    idea) echo "idea-refine" ;;
    spec) echo "spec-driven-development" ;;
    design) echo "design-flow" ;;
    plan) echo "planning-and-task-breakdown" ;;
    build) echo "incremental-implementation" ;;
    test) echo "test-driven-development" ;;
    review) echo "code-review-and-quality" ;;
    debug) echo "debugging-and-error-recovery" ;;
    ui) echo "frontend-ui-engineering" ;;
    api) echo "api-and-interface-design" ;;
    security) echo "security-and-hardening" ;;
    ship) echo "shipping-and-launch" ;;
    pm) echo "pm-flow" ;;
    agent) echo "agent-flow" ;;
    *) echo "${1:-}" ;;
  esac
}

normalize_target() {
  case "${1:-}" in
    claude|claude-code) echo "claude-code" ;;
    codex|gemini|openclaw|opencode) echo "${1:-}" ;;
    *) echo "" ;;
  esac
}

default_install_dest() {
  local target="$1"
  local scope="$2"
  case "$scope:$target" in
    project:codex) echo "$ROOT/.codex" ;;
    user:codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
    project:claude-code) echo "$ROOT/.claude" ;;
    user:claude-code) echo "$HOME/.claude" ;;
    project:gemini) echo "$ROOT/.gemini/extensions/dev-flow-quality" ;;
    user:gemini) echo "$HOME/.gemini/extensions/dev-flow-quality" ;;
    project:openclaw) echo "$ROOT/.openclaw" ;;
    user:openclaw) echo "$HOME/.openclaw" ;;
    project:opencode) echo "$ROOT/.opencode" ;;
    user:opencode) echo "$HOME/.config/opencode" ;;
    *) return 1 ;;
  esac
}

write_gemini_extension_manifest() {
  local target="$1"
  cat > "$target/gemini-extension.json" <<'EOF'
{
  "name": "dev-flow-quality",
  "version": "0.1.0",
  "description": "Agent skills and personas for lifecycle-driven software delivery",
  "contextFileName": "GEMINI.md",
  "plan": {
    "directory": ".gemini/plans"
  }
}
EOF
  cat > "$target/GEMINI.md" <<'EOF'
# Dev Flow Quality

Use the bundled skills for lifecycle-driven software delivery. For customer-facing UI, design-flow owns reference intake and screen acceptance; frontend-ui-engineering owns implementation, functional QA, monkey testing, and visual comparison.
EOF
}

install_adapter() {
  local target_raw="${1:-}"
  local target
  target="$(normalize_target "$target_raw")"
  if [[ -z "$target" ]]; then
    echo "Unknown install target: ${target_raw:-<missing>}" >&2
    echo "Targets: codex, claude-code, gemini, openclaw, opencode" >&2
    exit 1
  fi

  local scope="project"
  local dest=""
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --scope=*)
        scope="${1#--scope=}"
        shift
        ;;
      --dest)
        dest="${2:-}"
        shift 2
        ;;
      --dest=*)
        dest="${1#--dest=}"
        shift
        ;;
      *)
        echo "Unknown install option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$scope" != "project" && "$scope" != "user" ]]; then
    echo "Invalid scope: $scope" >&2
    echo "Use --scope project or --scope user." >&2
    exit 1
  fi
  if [[ -z "$dest" ]]; then
    dest="$(default_install_dest "$target" "$scope")"
  fi

  case "$target" in
    codex)
      copy_skill_dirs "$dest/skills"
      copy_agent_dirs "$dest/agents"
      copy_reference_dirs "$dest"
      copy_command_dirs "$dest/commands"
      embed_shared_references "$dest/skills"
      ;;
    claude-code)
      copy_skill_dirs "$dest/skills"
      copy_agent_dirs "$dest/agents"
      copy_reference_dirs "$dest"
      copy_claude_commands "$dest/commands"
      embed_shared_references "$dest/skills"
      ;;
    gemini)
      mkdir -p "$dest"
      copy_skill_dirs "$dest/skills"
      copy_agent_dirs "$dest/agents"
      copy_reference_dirs "$dest"
      copy_gemini_commands "$dest/commands"
      embed_shared_references "$dest/skills"
      write_gemini_extension_manifest "$dest"
      ;;
    openclaw)
      copy_skill_dirs "$dest/skills"
      copy_agent_dirs "$dest/agents"
      copy_reference_dirs "$dest"
      copy_command_dirs "$dest/commands"
      embed_shared_references "$dest/skills"
      ;;
    opencode)
      copy_skill_dirs "$dest/skills"
      copy_agent_dirs "$dest/agents"
      copy_reference_dirs "$dest"
      copy_command_dirs "$dest/commands"
      embed_shared_references "$dest/skills"
      ;;
  esac

  clean_metadata "$dest"
  echo "Installed $target adapter under $dest"
  echo "Scope: $scope"
}

skill_path() {
  local name
  name="$(skill_name "${1:-}")"
  echo "$PACK/skills/$name/SKILL.md"
}

require_pack() {
  if [[ ! -d "$PACK" ]]; then
    echo "Missing $PACK. Restore the canonical agent-skills/ directory before running dev-flow." >&2
    exit 1
  fi
}

cmd="${1:-help}"
require_pack

case "$cmd" in
  list)
    find "$PACK/skills" -mindepth 2 -maxdepth 2 -name SKILL.md \
      | sed "s#^$PACK/skills/##; s#/SKILL.md\$##" \
      | sort -u
    ;;
  show)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  path)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    echo "$path"
    ;;
  command)
    name="${2:-}"
    path="$PACK/commands/$name.md"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown command: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  agent)
    name="${2:-}"
    path="$PACK/agents/$name.md"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown agent persona: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  install)
    install_adapter "${2:-}" "${@:3}"
    ;;
  refs)
    find "$PACK/references" -maxdepth 1 -type f -name '*.md' | sort
    ;;
  init)
    project="${2:-}"
    dir="$(project_path "$project")"
    mkdir -p "$dir"/{ideas,product,agent,specs,design,tasks,reviews,ship,apps,packages,bin,.dev-flow}
    mkdir -p "$dir/design"/{references,mocks,screenshots,imagegen,cut-assets}
    mkdir -p "$dir/reviews/visual-screenshots"
    write_if_missing "$dir/.dev-flow/state.env" "PROJECT_NAME=\"$project\"
CURRENT_PHASE=\"idea\"
CURRENT_TASK=\"Refine the initial idea\"
BLOCKERS=\"none\"
LAST_VERIFICATION=\"not run\""
    write_if_missing "$dir/.dev-flow/applicability.env" "# Phase applicability for $project
# Values: auto, required, delegated, disabled
#
# auto: validate this phase only after matching artifacts exist
# required: treat this phase as part of phase transitions and ship-check
# delegated: treat visual direction as user-delegated when used with UI_REFERENCES
# disabled: skip this phase in phase transitions and ship-check
PM_FLOW=\"auto\"
AGENT_FLOW=\"auto\"
UI_FLOW=\"required\"
UI_REFERENCES=\"required\"
UI_IMAGEGEN=\"required\"
UI_MOCKUPS=\"auto\"
GIT_CHECKPOINTS=\"auto\""
    write_if_missing "$dir/.dev-flow/context.md" "# Context Loading: $project

Load only the files needed for the current phase.

- Idea: read \`ideas/\` and relevant user notes.
- Product: read \`product/\` only when PM_FLOW is required or product artifacts exist.
- Agent: read \`agent/\` only when AGENT_FLOW is required or agent artifacts exist.
- Spec: read approved idea/product/agent artifacts that apply, and existing app files if present.
- Design: read \`specs/SPEC.md\`, \`design/reference-intake.md\`, \`design/imagegen-prompts.md\`, user-provided references, existing screens, and platform constraints.
- Plan: read approved spec/design and inspect likely source boundaries.
- Build: read the assigned task, approved design docs, \`design/imagegen/\` layout/state boards, nearby source files, and tests.
- PDCA: keep \`tasks/PDCA.md\` current across Current Cycle, Plan, Do, Check, and Act so decisions and evidence survive handoffs.
- Review: read the diff, tests, and quality-gate output.
- QA: read verification evidence, functional and monkey test logs, visual comparison score, and exception screenshots only when a flow is blocked.
- Ship: read review results, QA evidence, verification evidence, and launch notes.

Do not bulk-load \`agent-skills/\` or unrelated project folders."
    write_if_missing "$dir/design/reference-intake.md" "# Reference Intake: $project

Use this before customer-facing UI design or visual polish.

## Reference Assets
- Put screenshots, reference images, Figma exports, mood boards, or product captures in:
  - \`design/references/\`
  - \`design/mocks/\`
  - \`design/screenshots/\`
  - \`design/imagegen/\`

## Reference Software
- Put product names, app store links, websites, Figma links, or competitor notes in \`design/reference-links.md\`.

## Decision
- If reference assets or software are provided, extract visual patterns before designing: layout density, navigation model, component style, spacing, typography, color, motion, and tone.
- If this is customer-facing UI and no reference is provided, ask the user for examples unless the user has explicitly delegated visual direction.
- If the user delegates visual direction, create a short reference board first and save it under \`design/\` before implementation planning."
    write_if_missing "$dir/design/DESIGN.md" "# Design: $project

## UX Problem

## Recommended Direction

## Alternatives Considered

## Information Architecture

## Interaction Model

## Visual System

## Design Artifacts

## Build Implications
"
    write_if_missing "$dir/design/VISUAL_SYSTEM.md" "# Visual System: $project

## Reference Influence

## Palette

## Typography

## Spacing and Layout

## Components and Motion

## Forbidden Patterns
"
    write_if_missing "$dir/design/SCREEN_ACCEPTANCE.md" "# Screen Acceptance: $project

## [Screen Name]
- Required content:
- Required states:
- Breakpoints:
- Required imagegen boards:
- Visual acceptance:
- Accessibility acceptance:
"
    write_if_missing "$dir/design/imagegen-prompts.md" "# Imagegen Prompts: $project

Use the installed imagegen skill before implementation planning for every UI screen.

## Required Coverage
- Derive the canonical screen list from the PRD/spec/design/interaction model and record every required screen as a \`##\` section in \`SCREEN_ACCEPTANCE.md\`.
- Generate 1-N layout and state images for each \`SCREEN_ACCEPTANCE.md\` screen.
- Add at least one Screen Coverage row for each exact \`SCREEN_ACCEPTANCE.md\` screen heading, pointing to a final raster/PDF path under \`design/imagegen/\`.
- Save final selected images under \`design/imagegen/\`.
- SVG/Mermaid/Markdown drafts are allowed as structure references only. If used, render or screenshot the draft, feed it to imagegen as a reference, and save the final raster/PDF output under \`design/imagegen/\`.
- \`design-check\` requires a raster/PDF imagegen board for every \`SCREEN_ACCEPTANCE.md\` screen; SVG drafts alone do not satisfy the gate.
- Record the prompt, intended screen/state, saved path, and design decision for each image.
- If bitmap icons, illustrations, or UI cut assets are needed, save them under \`design/cut-assets/\` and list them in \`design/cut-assets/ASSET_MANIFEST.md\`.

## Screen Coverage
| Screen | State | Prompt summary | Saved image path | Build notes |
|---|---|---|---|---|

## Prompts
"
    write_if_missing "$dir/design/cut-assets/ASSET_MANIFEST.md" "# Cut Assets: $project

List bitmap icons, illustrations, or UI elements cut from imagegen outputs when implementation needs them.

| Asset | Source image | Final path | Usage | Notes |
|---|---|---|---|---|
"
    write_if_missing "$dir/design/reference-links.md" "# Reference Links: $project

Add user-provided reference apps, websites, Figma links, screenshots descriptions, or competitor notes below.

## References"
    write_if_missing "$dir/tasks/status.md" "# Project Status: $project

## Current State
- Phase: idea
- Current task: Refine the initial idea
- Blockers: none
- Last verification: not run

## Phase Checklist
- [ ] Idea approved
- [ ] Spec approved
- [ ] Design approved
- [ ] Plan approved
- [ ] Build slices complete
- [ ] Tests and quality gates pass
- [ ] Review complete
- [ ] Ship package ready

## Human Review Gates
- Requirement confirmation
- Customer-facing visual direction when no reference image/software is provided
- High-risk architecture decisions
- Security, payment, permissions, or data deletion behavior
- Production launch approval"
    write_if_missing "$dir/tasks/quality-gates.md" "# Quality Gates: $project

Project-specific verification belongs here. Keep commands runnable from this project
folder and mirror them in \`bin/check\` when they become stable.

## Default Gate
- [ ] Required workflow folders exist
- [ ] Status ledger exists
- [ ] Context loading guidance exists
- [ ] Reference intake exists for customer-facing UI work
- [ ] Imagegen layout/state boards exist under \`design/imagegen/\` before UI implementation
- [ ] Cut assets are listed under \`design/cut-assets/ASSET_MANIFEST.md\` when bitmap UI assets are needed

## Add When The Project Has Code
- [ ] Lint
- [ ] Type check
- [ ] Unit tests
- [ ] Build
- [ ] Browser or device smoke test, when user-facing
- [ ] Functional flow test, when user-facing
- [ ] Monkey or exploratory stress test, when user-facing
- [ ] Visual comparison score is at least 90/100 against approved imagegen boards, when user-facing
- [ ] \`tasks/PDCA.md\` records Current Cycle, Plan, Do, Check, and Act evidence for the current cycle
- [ ] \`bin/dev-flow pdca-check $project\`, before delivery
- [ ] \`bin/dev-flow design-check $project\`, before implementation planning for customer-facing UI
- [ ] \`bin/dev-flow qa-check $project\`, before delivery for customer-facing UI"
    write_if_missing "$dir/tasks/PDCA.md" "# PDCA: $project

Use this as the handoff ledger for each delivery cycle. Keep each section current
instead of reconstructing decisions at release time.

## Current Cycle
- Cycle ID:
- Scope:
- Owner / agent:
- Started:
- Checkpoint:

## Plan
- Objective:
- Source artifacts: ideas/idea-brief.md, specs/SPEC.md, design/DESIGN.md when UI applies, tasks/PLAN.md
- Acceptance evidence:
- Quality gates:

## Do
- Implementation slices:
- Changed areas:
- Build artifacts:

## Check
- Verification evidence:
- Functional test evidence:
- Monkey test evidence:
- UI visual comparison evidence, when applicable:

## Act
- Decision:
- Standardize:
- Iterate / follow-up:
- Rollback or recovery notes:
"
    write_if_missing "$dir/reviews/FUNCTIONAL_TEST.md" "# Functional Test: $project

Record normal happy-path and critical user-flow verification here after implementation.

## Commands / Devices

## Flows Checked

## Result
"
    write_if_missing "$dir/reviews/MONKEY_TEST.md" "# Monkey Test: $project

Record random, exploratory, stress, or resilience testing here after implementation.

## Scope

## Events / Inputs

## Result
"
    write_if_missing "$dir/reviews/VISUAL_COMPARISON.md" "# Visual Comparison: $project

Compare the implemented UI with approved imagegen boards and design artifacts.

Overall score: 0/100

## Compared Inputs
- Imagegen boards:
- Runtime UI surfaces:
- Exception screenshots, only if a flow was blocked:

## Screen Fidelity Matrix
| Screen | Approved board path | Runtime surface | Fidelity score | Notes |
|---|---|---|---|---|

## Score Breakdown
- Layout and hierarchy:
- Component fidelity:
- State coverage:
- Responsiveness:
- Polish:

## Differences
-

## Decision
"
    write_if_missing "$dir/bin/check" "#!/usr/bin/env bash
set -euo pipefail

ROOT=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")/..\" && pwd)\"

required_dirs=(ideas product agent specs design design/references design/mocks design/screenshots design/imagegen design/cut-assets tasks reviews reviews/visual-screenshots ship apps packages .dev-flow)
for d in \"\${required_dirs[@]}\"; do
  [[ -d \"\$ROOT/\$d\" ]] || { echo \"Missing directory: \$d\" >&2; exit 1; }
done

required_files=(.dev-flow/state.env .dev-flow/context.md design/reference-intake.md design/reference-links.md design/imagegen-prompts.md design/cut-assets/ASSET_MANIFEST.md tasks/status.md tasks/quality-gates.md tasks/PDCA.md reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md reviews/VISUAL_COMPARISON.md)
for f in \"\${required_files[@]}\"; do
  [[ -f \"\$ROOT/\$f\" ]] || { echo \"Missing file: \$f\" >&2; exit 1; }
done

[[ -f \"\$ROOT/.dev-flow/applicability.env\" ]] || { echo \"Missing file: .dev-flow/applicability.env\" >&2; exit 1; }

echo \"Default workflow gate passed for \$(basename \"\$ROOT\").\""
    chmod +x "$dir/bin/check"
    echo "Initialized $dir"
    echo "Next: bin/dev-flow next $project"
    ;;
  status)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    load_project_state "$project"
    echo "Project: $project"
    echo "Path: $dir"
    echo "Phase: $CURRENT_PHASE"
    echo "Current task: $CURRENT_TASK"
    echo "Blockers: $BLOCKERS"
    echo "Last verification: $LAST_VERIFICATION"
    echo
    echo "Artifacts:"
    find "$dir" -maxdepth 4 -type f \
      | sed "s#^$dir/##" \
      | sort
    ;;
  phase)
    project="${2:-}"
    phase="${3:-}"
    task=""
    force="false"
    shift 3 || true
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --force) force="true"; shift ;;
        *)
          if [[ -z "$task" ]]; then task="$1"; else task="$task $1"; fi
          shift
          ;;
      esac
    done
    require_project "$project"
    if ! is_valid_phase "$phase"; then
      echo "Invalid phase: ${phase:-<missing>}" >&2
      echo "Valid phases: idea, pm, agent, spec, design, plan, build, test, review, ship" >&2
      exit 1
    fi
    if [[ "$force" != "true" ]]; then
      verify_prior_applicable_phases "$project" "$phase"
    fi
    load_project_state "$project"
    if [[ -z "$task" ]]; then
      task="$CURRENT_TASK"
    fi
    write_project_state "$project" "$phase" "$task" "$BLOCKERS" "$LAST_VERIFICATION"
    dir="$(project_path "$project")"
    {
      echo
      echo "## Update $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      echo "- Phase: $phase"
      echo "- Current task: $task"
    } >> "$dir/tasks/status.md"
    echo "Updated $project to phase: $phase"
    echo "Next: bin/dev-flow next $project"
    ;;
  next)
    project="${2:-}"
    require_project "$project"
    load_project_state "$project"
    echo "Project: $project"
    echo "Current phase: $CURRENT_PHASE"
    echo
    next_prompt_for_phase "$CURRENT_PHASE"
    ;;
  verify-phase)
    project="${2:-}"
    phase="${3:-}"
    verify_phase_impl "$project" "$phase"
    record_verification "$project" "verify-phase:$phase passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  ship-check)
    project="${2:-}"
    ship_check_impl "$project"
    record_verification "$project" "ship-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  pdca-check)
    project="${2:-}"
    pdca_check_impl "$project"
    record_verification "$project" "pdca-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  reference-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    load_project_applicability "$project"
    if [[ "$mode" == "--delegated" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    assets="$(count_reference_assets "$dir")"
    links="$(count_reference_links "$dir")"
    total=$((assets + links))
    echo "Project: $project"
    echo "Reference assets: $assets"
    echo "Reference links/software notes: $links"
    if ! references_required_loaded; then
      echo "Reference intake passed by project applicability: UI_REFERENCES=$UI_REFERENCES."
      echo "Record the delegated visual direction in DESIGN.md and generate imagegen boards before implementation."
      exit 0
    fi
    if [[ "$total" -gt 0 ]]; then
      echo "Reference intake passed."
      echo "Use these references in design requirements and visual comparison QA."
      exit 0
    fi
    echo "No reference assets or reference software found."
    echo "For customer-facing UI, ask the user for reference images, screenshots, Figma links, app names, or websites before design."
    echo "If the user delegates visual direction, create a reference board under work/$project/design/ before implementation planning."
    if [[ "$mode" == "--required" ]]; then
      exit 1
    fi
    ;;
  design-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    failures=0
    imagegen_assets="$(count_imagegen_artifacts "$dir")"
    final_imagegen_assets="$(count_final_imagegen_artifacts "$dir")"
    load_project_applicability "$project"
    if [[ "$mode" == "--allow-no-reference" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    if references_required_loaded; then
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      if [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or set UI_REFERENCES=\"delegated\" after the user explicitly delegates visual direction." >&2
        failures=$((failures + 1))
      fi
    fi
    if setting_enabled "$UI_IMAGEGEN"; then
      if ! has_content "$dir/design/imagegen-prompts.md"; then
        echo "Missing or too thin: design/imagegen-prompts.md" >&2
        failures=$((failures + 1))
      fi
      if [[ "$(count_invalid_imagegen_artifacts "$dir")" -gt 0 ]]; then
        echo "Invalid imagegen artifact(s): files under design/imagegen/ must be real non-empty image/PDF files, not text placeholders." >&2
        failures=$((failures + 1))
      fi
      if [[ "$imagegen_assets" -eq 0 ]]; then
        echo "Missing imagegen UI boards: save 1-N layout/state images per screen under design/imagegen/ before implementation planning." >&2
        failures=$((failures + 1))
      fi
      if [[ "$final_imagegen_assets" -eq 0 ]]; then
        echo "Missing final imagegen UI board: SVG/Mermaid/code-native drafts are allowed as layout references, but design/imagegen/ must include at least one raster image or PDF generated by imagegen." >&2
        failures=$((failures + 1))
      fi
      if ! check_imagegen_screen_coverage "$dir"; then
        failures=$((failures + 1))
      fi
    fi
    for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
      if ! has_content "$dir/$file"; then
        echo "Missing or too thin: $file" >&2
        failures=$((failures + 1))
      fi
    done
    if ! check_design_package_structure "$dir"; then
      failures=$((failures + 1))
    fi
    if [[ "$failures" -gt 0 ]]; then
      echo "Design check failed for $project." >&2
      exit 1
    fi
    echo "Design check passed for $project with $imagegen_assets imagegen artifact(s), including $final_imagegen_assets final raster/PDF board(s), covering every SCREEN_ACCEPTANCE screen."
    ;;
  qa-check|visual-check)
    project="${2:-}"
    qa_check_impl "$project"
    ;;
  check)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    if [[ ! -x "$dir/bin/check" ]]; then
      echo "Missing executable quality gate: $dir/bin/check" >&2
      exit 1
    fi
    (cd "$dir" && ./bin/check)
    ;;
  package-adapters)
    out="${2:-dist/dev-flow-native}"
    if [[ -e "$out" ]]; then
      echo "Output already exists: $out" >&2
      echo "Choose a new output directory." >&2
      exit 1
    fi
    mkdir -p "$out"

    copy_skill_dirs "$out/codex/skills"
    copy_agent_dirs "$out/codex/agents"
    copy_reference_dirs "$out/codex"
    copy_command_dirs "$out/codex/commands"
    embed_shared_references "$out/codex/skills"

    copy_skill_dirs "$out/claude-code/skills"
    copy_agent_dirs "$out/claude-code/agents"
    copy_reference_dirs "$out/claude-code"
    embed_shared_references "$out/claude-code/skills"
    copy_claude_commands "$out/claude-code/.claude/commands"

    mkdir -p "$out/gemini/dev-flow-quality"
    copy_skill_dirs "$out/gemini/dev-flow-quality/skills"
    copy_agent_dirs "$out/gemini/dev-flow-quality/agents"
    copy_reference_dirs "$out/gemini/dev-flow-quality"
    embed_shared_references "$out/gemini/dev-flow-quality/skills"
    copy_gemini_commands "$out/gemini/dev-flow-quality/commands"
    write_gemini_extension_manifest "$out/gemini/dev-flow-quality"

    copy_skill_dirs "$out/openclaw/skills"
    copy_agent_dirs "$out/openclaw/agents"
    copy_reference_dirs "$out/openclaw"
    copy_command_dirs "$out/openclaw/commands"
    embed_shared_references "$out/openclaw/skills"

    copy_skill_dirs "$out/opencode/.opencode/skills"
    copy_agent_dirs "$out/opencode/.opencode/agents"
    copy_reference_dirs "$out/opencode/.opencode"
    copy_command_dirs "$out/opencode/.opencode/commands"
    embed_shared_references "$out/opencode/.opencode/skills"

    cat > "$out/INSTALL.md" <<'EOF'
# Agent Skills Native Adapter Package

Install the generated folders into the target agent surface:

- Codex App/CLI: copy `codex/skills/*` to `~/.codex/skills/`. `codex/commands/` contains reusable prompt shortcuts for hosts that support custom commands or snippets.
- Claude Code: copy `claude-code/skills/*` to `~/.claude/skills/` or project `.claude/skills/`; copy `.claude/commands/` into a project when slash commands are desired.
- Claude.ai/API: upload or package each skill folder separately for that surface.
- Gemini CLI: run `gemini extensions link <path-to>/gemini/dev-flow-quality` while developing, or `gemini extensions install <path-to>/gemini/dev-flow-quality`.
- OpenClaw: copy `openclaw/skills/*` to `~/.openclaw/skills/`, `~/.agents/skills/`, or workspace `skills/`; use `openclaw/commands/` as command snippets where supported.
- OpenCode: copy `opencode/.opencode/skills/*` into a workspace `.opencode/skills/`, or copy to `~/.config/opencode/skills/`; copy `.opencode/commands/` where supported.

Agent personas are included under each adapter's `agents/` directory when the platform supports persona/sub-agent files. Shared references are embedded into each packaged skill so standalone skill installation keeps reference files available.

The helper can also install directly:

```bash
bin/dev-flow install codex --scope user
bin/dev-flow install claude-code --scope project
bin/dev-flow install gemini --scope project
bin/dev-flow install openclaw --scope user
bin/dev-flow install opencode --scope project
```
EOF
    clean_metadata "$out"
    echo "Packaged adapters under $out"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
