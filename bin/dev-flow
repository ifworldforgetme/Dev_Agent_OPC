#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACK="$ROOT/agent-skills"
LIB="$PACK/lib/dev-flow"
TEMPLATES="$PACK/templates/project"

if [[ -f "$LIB/constants.sh" ]]; then
  # shellcheck source=/dev/null
  source "$LIB/constants.sh"
fi
if [[ -f "$LIB/templates.sh" ]]; then
  # shellcheck source=/dev/null
  source "$LIB/templates.sh"
fi

usage() {
  cat <<'EOF'
Usage:
  bin/dev-flow list
  bin/dev-flow manifest
  bin/dev-flow show <alias-or-skill>
  bin/dev-flow path <alias-or-skill>
  bin/dev-flow command <opc-flow|opc-role|opc-next|opc-check|idea|pm|agent|spec|design|figma-design|figma-library|plan|build|test|review|ship|debug|ui|api|security|code-simplify>
  bin/dev-flow agent <opc-code-reviewer|opc-product-designer|opc-test-engineer|opc-security-auditor|opc-ui-quality-reviewer>
  bin/dev-flow refs
  bin/dev-flow install <codex|claude-code|gemini|openclaw|opencode> [--scope project|user] [--dest path] [--mode native|full]
  bin/dev-flow uninstall <codex|claude-code|gemini|openclaw|opencode> [--scope project|user] [--dest path]
  bin/dev-flow init <project-name> [--type ui|agent|api|library|docs]
  bin/dev-flow status <project-name>
  bin/dev-flow phase <project-name> <idea|pm|agent|spec|design|plan|build|test|review|ship> [task] [--force]
  bin/dev-flow next <project-name>
  bin/dev-flow verify-phase <project-name> <idea|pm|agent|spec|design|plan|build|test|review|ship>
  bin/dev-flow pdca-check <project-name>
  bin/dev-flow env-check <project-name>
  bin/dev-flow ship-check <project-name>
  bin/dev-flow doctor <project-name>
  bin/dev-flow migrate <project-name> [--type ui|agent|api|library|docs]
  bin/dev-flow reference-check <project-name> [--required|--delegated]
  bin/dev-flow asset-check <project-name>
  bin/dev-flow figma-check <project-name>
  bin/dev-flow design-check <project-name> [--allow-no-reference]
  bin/dev-flow qa-check <project-name>
  bin/dev-flow visual-check <project-name>
  bin/dev-flow check <project-name>
  bin/dev-flow package-adapters [output-dir]

Aliases:
  idea      -> idea-refine
  spec      -> spec-driven-development
  design    -> design-flow
  plan      -> planning-and-task-breakdown
  build     -> incremental-implementation
  test      -> test-driven-development
  review    -> code-review-and-quality
  debug     -> debugging-and-error-recovery
  ui        -> frontend-ui-engineering
  api       -> api-and-interface-design
  security  -> security-and-hardening
  ship      -> shipping-and-launch
  pm        -> pm-flow
  agent     -> agent-flow

Applicability:
  Optional phases are controlled by work/<project-name>/.dev-flow/applicability.env.
  Set PM_FLOW, AGENT_FLOW, UI_FLOW, UI_REFERENCES, UI_DESIGN_ASSETS, UI_FIGMA_HANDOFF, or UI_MOCKUPS to auto, required, delegated, or disabled.
  Project type is recorded in work/<project-name>/.dev-flow/schema.env.
EOF
}

project_path() {
  local name="${1:-}"
  if [[ -z "$name" || "$name" == *"/"* || "$name" == "." || "$name" == ".." ]]; then
    echo "Invalid project name: ${name:-<missing>}" >&2
    echo "Use a simple folder name, for example: hotel-agent-workbench" >&2
    exit 1
  fi
  echo "$ROOT/work/$name"
}

state_path() {
  echo "$(project_path "${1:-}")/.dev-flow/state.env"
}

schema_path() {
  echo "$(project_path "${1:-}")/.dev-flow/schema.env"
}

applicability_path() {
  echo "$(project_path "${1:-}")/.dev-flow/applicability.env"
}

require_project() {
  local dir
  dir="$(project_path "${1:-}")"
  if [[ ! -d "$dir" ]]; then
    echo "Unknown project: ${1:-<missing>}" >&2
    echo "Create it first with: bin/dev-flow init <project-name>" >&2
    exit 1
  fi
}

load_project_state() {
  local state
  state="$(state_path "${1:-}")"
  if [[ -f "$state" ]]; then
    # shellcheck disable=SC1090
    source "$state"
  fi
  CURRENT_PHASE="${CURRENT_PHASE:-idea}"
  CURRENT_TASK="${CURRENT_TASK:-Refine the initial idea}"
  BLOCKERS="${BLOCKERS:-none}"
  LAST_VERIFICATION="${LAST_VERIFICATION:-not run}"
}

load_project_schema() {
  local schema
  schema="$(schema_path "${1:-}")"
  PROJECT_SCHEMA_VERSION="${PROJECT_SCHEMA_VERSION:-1}"
  PROJECT_TYPE="${PROJECT_TYPE:-ui}"
  if [[ -f "$schema" ]]; then
    # shellcheck disable=SC1090
    source "$schema"
  fi
  PROJECT_SCHEMA_VERSION="${PROJECT_SCHEMA_VERSION:-1}"
  PROJECT_TYPE="${PROJECT_TYPE:-ui}"
}

project_type_from_options() {
  local project_type="ui"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --type)
        project_type="${2:-}"
        shift 2
        ;;
      --type=*)
        project_type="${1#--type=}"
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
  if ! dev_flow_valid_project_type "$project_type"; then
    echo "Invalid project type: ${project_type:-<missing>}" >&2
    echo "Use one of: ui, agent, api, library, docs." >&2
    exit 1
  fi
  echo "$project_type"
}

is_valid_phase() {
  case "${1:-}" in
    idea|pm|agent|spec|design|plan|build|test|review|ship) return 0 ;;
    *) return 1 ;;
  esac
}

write_project_state() {
  local project="$1"
  local phase="$2"
  local task="$3"
  local blockers="$4"
  local verification="$5"
  local state
  state="$(state_path "$project")"
  mkdir -p "$(dirname "$state")"
  {
    printf 'PROJECT_NAME=%q\n' "$project"
    printf 'CURRENT_PHASE=%q\n' "$phase"
    printf 'CURRENT_TASK=%q\n' "$task"
    printf 'BLOCKERS=%q\n' "$blockers"
    printf 'LAST_VERIFICATION=%q\n' "$verification"
  } > "$state"
}

write_project_schema_file() {
  local project="$1"
  local project_type="$2"
  local schema
  schema="$(schema_path "$project")"
  mkdir -p "$(dirname "$schema")"
  {
    printf 'PROJECT_SCHEMA_VERSION="%s"\n' "$DEV_FLOW_PROJECT_SCHEMA_VERSION"
    printf 'PROJECT_TYPE="%s"\n' "$project_type"
  } > "$schema"
}

write_if_missing() {
  local path="$1"
  local content="$2"
  if [[ ! -e "$path" ]]; then
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$content" > "$path"
  fi
}

ensure_project_dirs() {
  local dir="$1"
  mkdir -p "$dir"/{ideas,product,agent,specs,design,tasks,reviews,ship,apps,packages,bin,.dev-flow}
  mkdir -p "$dir/design"/{references,drafts,mocks,screenshots,sources,approved,cut-assets}
  mkdir -p "$dir/design/sources"/{imagegen,gpt-image,figma,uploads,approved,design-system,html}
  mkdir -p "$dir/design/approved"/{screens,components,html}
  mkdir -p "$dir/design/cut-assets"/{icons,sprites,illustrations,backgrounds}
  mkdir -p "$dir/reviews/visual-screenshots"
}

write_project_template() {
  local dir="$1"
  local rel="$2"
  local template="$3"
  local project="$4"
  local project_type="$5"
  if [[ ! -f "$TEMPLATES/$template" ]]; then
    echo "Missing project template: $TEMPLATES/$template" >&2
    exit 1
  fi
  dev_flow_write_template_if_missing "$dir/$rel" "$TEMPLATES/$template" "$project" "$project_type"
}

write_project_templates() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  local app_template
  app_template="$(dev_flow_applicability_template_for_type "$project_type")"
  [[ -n "$app_template" ]] || { echo "Unsupported project type: $project_type" >&2; exit 1; }
  write_project_template "$dir" ".dev-flow/schema.env" "schema.env" "$project" "$project_type"
  write_project_template "$dir" ".dev-flow/state.env" "state.env" "$project" "$project_type"
  write_project_template "$dir" ".dev-flow/applicability.env" "$app_template" "$project" "$project_type"
  write_project_template "$dir" ".dev-flow/context.md" "context.md" "$project" "$project_type"
  write_project_template "$dir" ".dev-flow/HOST_REQUIREMENTS.md" "host-requirements.md" "$project" "$project_type"
  write_project_template "$dir" "design/reference-intake.md" "reference-intake.md" "$project" "$project_type"
  write_project_template "$dir" "design/reference-links.md" "reference-links.md" "$project" "$project_type"
  write_project_template "$dir" "design/REFERENCE_BOARD.md" "reference-board.md" "$project" "$project_type"
  write_project_template "$dir" "design/FIGMA_HANDOFF.md" "figma-handoff.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN.md" "design.md" "$project" "$project_type"
  write_project_template "$dir" "design/VISUAL_SYSTEM.md" "visual-system.md" "$project" "$project_type"
  write_project_template "$dir" "design/SCREEN_ACCEPTANCE.md" "screen-acceptance.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN_ARTIFACTS.md" "design-artifacts.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN_IMAGE_DESCRIPTIONS.md" "design-image-descriptions.md" "$project" "$project_type"
  write_project_template "$dir" "design/cut-assets/ASSET_MANIFEST.md" "cut-assets-manifest.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/status.md" "status.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/quality-gates.md" "quality-gates.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/PDCA.md" "pdca.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/IMPLEMENTATION_TRACE.md" "implementation-trace.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/FUNCTIONAL_TEST.md" "functional-test.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/MONKEY_TEST.md" "monkey-test.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/VISUAL_COMPARISON.md" "visual-comparison.md" "$project" "$project_type"
  write_project_template "$dir" "bin/check" "check.sh" "$project" "$project_type"
  chmod +x "$dir/bin/check"
}

phase_default_task() {
  case "${1:-}" in
    idea) echo "Refine the initial idea" ;;
    pm) echo "Write product requirements and acceptance criteria" ;;
    agent) echo "Design agent workflow and evaluations" ;;
    spec) echo "Write buildable SPEC.md" ;;
    design) echo "Create approved design package" ;;
    plan) echo "Plan implementation from approved artifacts" ;;
    build) echo "Implement the next task slice" ;;
    test) echo "Verify implemented behavior" ;;
    review) echo "Review current changes" ;;
    ship) echo "Prepare launch evidence and go/no-go decision" ;;
    *) echo "Continue workflow" ;;
  esac
}

next_applicable_phase_after() {
  local project="$1"
  local current="$2"
  local phase seen
  seen="false"
  for phase in idea pm agent spec design plan build test review ship; do
    if [[ "$seen" == "true" ]]; then
      if phase_is_applicable "$project" "$phase"; then
        echo "$phase"
        return 0
      fi
    fi
    if [[ "$phase" == "$current" ]]; then
      seen="true"
    fi
  done
  echo ""
}

phase_skill_files() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    build)
      echo "- agent-skills/skills/incremental-implementation/SKILL.md"
      echo "- agent-skills/skills/test-driven-development/SKILL.md"
      if phase_is_applicable "$project" design; then
        echo "- agent-skills/skills/frontend-ui-engineering/SKILL.md"
      fi
      ;;
    *)
      echo "- agent-skills/skills/$(skill_name "$phase")/SKILL.md"
      ;;
  esac
}

phase_load_list() {
  local project="$1"
  local phase="$2"
  echo "- work/$project/.dev-flow/context.md"
  echo "- agent-skills/commands/$phase.md"
  phase_skill_files "$project" "$phase"
  case "$phase" in
    idea)
      echo "- user request and existing work/$project/ideas/ notes"
      ;;
    pm)
      echo "- work/$project/ideas/idea-brief.md"
      echo "- work/$project/product/ when artifacts already exist"
      ;;
    agent)
      echo "- work/$project/ideas/idea-brief.md"
      echo "- work/$project/product/ when product artifacts apply"
      echo "- existing work/$project/agent/ artifacts"
      ;;
    spec)
      echo "- work/$project/ideas/idea-brief.md"
      echo "- work/$project/product/ when PM_FLOW applies"
      echo "- work/$project/agent/ when AGENT_FLOW applies"
      echo "- existing work/$project/apps/ and work/$project/packages/ when present"
      ;;
    design)
      echo "- work/$project/specs/SPEC.md"
      echo "- work/$project/design/reference-intake.md"
      echo "- work/$project/design/reference-links.md"
      echo "- work/$project/design/references/ and design/screenshots/"
      echo "- agent-skills/references/design-artifacts.md"
      echo "- agent-skills/references/figma-handoff.md when Figma is used"
      ;;
    plan)
      echo "- work/$project/specs/SPEC.md"
      if phase_is_applicable "$project" design; then
        echo "- work/$project/design/DESIGN.md"
        echo "- work/$project/design/SCREEN_ACCEPTANCE.md"
        echo "- work/$project/design/DESIGN_ARTIFACTS.md"
      fi
      echo "- existing work/$project/apps/ and work/$project/packages/ source boundaries"
      ;;
    build)
      echo "- work/$project/tasks/PLAN.md"
      echo "- assigned task and nearby source/tests under work/$project/apps/ or packages/"
      if phase_is_applicable "$project" design; then
        echo "- work/$project/tasks/IMPLEMENTATION_TRACE.md"
        echo "- work/$project/design/approved/ and design/cut-assets/ASSET_MANIFEST.md"
        echo "- work/$project/design/approved/html/ and FIGMA_HANDOFF.md when applicable"
      fi
      ;;
    test)
      echo "- work/$project/tasks/PLAN.md"
      echo "- implemented source and existing tests"
      echo "- work/$project/tasks/PDCA.md"
      ;;
    review)
      echo "- current diff, task plan, spec, tests, and verification evidence"
      echo "- work/$project/reviews/ when prior review artifacts exist"
      ;;
    ship)
      echo "- work/$project/ship/ and work/$project/reviews/"
      echo "- work/$project/tasks/PDCA.md"
      echo "- final build/test/package evidence"
      ;;
  esac
}

phase_required_outputs() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    idea)
      echo "- ideas/idea-brief.md"
      ;;
    pm)
      echo "- product/PRD.md"
      echo "- product/USER_STORIES.md"
      echo "- product/ACCEPTANCE.md"
      echo "- product/METRICS.md"
      ;;
    agent)
      echo "- agent/AGENT_SPEC.md"
      echo "- agent/WORKFLOW.md"
      echo "- agent/TOOLS_AND_PERMISSIONS.md"
      echo "- agent/PROMPTS_AND_SKILLS.md"
      echo "- agent/EVALS.md"
      echo "- agent/FAILURE_RECOVERY.md"
      echo "- agent/OPERATIONS.md"
      ;;
    spec)
      echo "- specs/SPEC.md"
      ;;
    design)
      echo "- design/DESIGN.md"
      echo "- design/VISUAL_SYSTEM.md"
      echo "- design/SCREEN_ACCEPTANCE.md"
      echo "- design/DESIGN_ARTIFACTS.md"
      echo "- design/approved/ real raster/PDF assets"
      echo "- design/DESIGN_IMAGE_DESCRIPTIONS.md and design/approved/html/ when AI-generated images are used"
      echo "- design/FIGMA_HANDOFF.md when Figma-backed assets are used"
      echo "- design/cut-assets/ASSET_MANIFEST.md"
      ;;
    plan)
      echo "- tasks/PLAN.md"
      echo "- tasks/quality-gates.md"
      echo "- tasks/PDCA.md Plan section"
      if phase_is_applicable "$project" design; then
        echo "- tasks/IMPLEMENTATION_TRACE.md"
      fi
      ;;
    build)
      echo "- implemented source under apps/ or packages/"
      echo "- tests or executable proof for the slice"
      echo "- tasks/PDCA.md Do section"
      ;;
    test)
      echo "- reviews/VERIFICATION.md or reviews/BLOCKED_BUILD.md"
      echo "- tasks/PDCA.md Check section"
      if phase_is_applicable "$project" design; then
        echo "- reviews/FUNCTIONAL_TEST.md"
        echo "- reviews/MONKEY_TEST.md"
        echo "- reviews/VISUAL_COMPARISON.md after the UI batch is complete"
      fi
      ;;
    review)
      echo "- reviews/REVIEW.md"
      ;;
    ship)
      echo "- ship/LAUNCH.md"
      echo "- tasks/PDCA.md Act section"
      echo "- rollback plan and GO/NO-GO decision"
      ;;
  esac
}

phase_gate_list() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    design)
      echo "- bin/dev-flow design-check $project"
      ;;
    build)
      echo "- bin/dev-flow verify-phase $project build"
      echo "- bin/dev-flow check $project"
      ;;
    test)
      echo "- bin/dev-flow verify-phase $project test"
      if phase_is_applicable "$project" design; then
        echo "- bin/dev-flow qa-check $project after the planned UI batch is complete"
      fi
      ;;
    ship)
      echo "- bin/dev-flow pdca-check $project"
      echo "- bin/dev-flow ship-check $project"
      ;;
    *)
      echo "- bin/dev-flow verify-phase $project $phase"
      ;;
  esac
}

phase_blockers() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    design)
      echo "- no reference assets/links and UI_REFERENCES is not delegated"
      echo "- delegated visual direction without design/REFERENCE_BOARD.md"
      echo "- missing formal raster/PDF/Figma approved assets for accepted screens"
      echo "- AI-generated approved images without semantic HTML companions"
      echo "- SVG or runtime screenshots used as screen layout source"
      ;;
    plan)
      echo "- missing approved spec"
      if phase_is_applicable "$project" design; then
        echo "- missing design-check pass or implementation trace"
      fi
      ;;
    build)
      echo "- unclear task acceptance criteria"
      echo "- missing local verification command"
      if phase_is_applicable "$project" design; then
        echo "- missing design-check pass before UI code"
      fi
      ;;
    test)
      echo "- proof cannot reproduce or verify the behavior"
      echo "- blocked build without reviews/BLOCKED_BUILD.md"
      ;;
    ship)
      echo "- missing rollback plan"
      echo "- failed pdca-check, ship-check, or launch blocker review"
      ;;
    *)
      echo "- required source artifact is missing or too thin"
      echo "- assumptions, tradeoffs, or human-review blockers are unresolved"
      ;;
  esac
}

next_prompt_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local next_phase
  if ! is_valid_phase "$phase"; then
    echo "Unknown phase: ${phase:-<missing>}"
    echo "Valid phases: idea, pm, agent, spec, design, plan, build, test, review, ship"
    return 0
  fi
  next_phase="$(next_applicable_phase_after "$project" "$phase")"
  echo "Next command: Use local flow: $phase"
  echo "Command file: agent-skills/commands/$phase.md"
  echo "Primary skill files:"
  phase_skill_files "$project" "$phase"
  echo
  echo "Load:"
  phase_load_list "$project" "$phase"
  echo
  echo "Required outputs:"
  phase_required_outputs "$project" "$phase"
  echo
  echo "Gate before next phase:"
  phase_gate_list "$project" "$phase"
  echo
  echo "Blocked if:"
  phase_blockers "$project" "$phase"
  echo
  echo "After pass:"
  if [[ -n "$next_phase" ]]; then
    echo "- bin/dev-flow phase $project $next_phase \"$(phase_default_task "$next_phase")\""
  else
    echo "- Workflow is at the final phase; keep ship evidence and PDCA Act current."
  fi
}

mime_type_for_file() {
  local path="$1"
  file --mime-type -b "$path" 2>/dev/null || file -bI "$path" 2>/dev/null | sed 's/;.*//'
}

is_supported_artifact() {
  local path="$1"
  local kind="${2:-image}"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$kind:$mime" in
      image:image/svg+xml|image:text/xml|image:application/xml) return 1 ;;
      cut:image/svg+xml) return 0 ;;
      cut:text/xml|cut:application/xml)
        case "$path" in
          *.[Ss][Vv][Gg]) return 0 ;;
          *) return 1 ;;
        esac
        ;;
      image:image/*|image:application/pdf) return 0 ;;
      cut:image/*|cut:application/pdf) return 0 ;;
      reference:image/*|reference:application/pdf|reference:application/json) return 0 ;;
    esac
    case "$kind:$path" in
      reference:*.[Ff][Ii][Gg]) return 0 ;;
    esac
    return 1
  fi
  return 0
}

count_supported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_unsupported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if ! is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_forbidden_svg_artifacts() {
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( -iname '*.svg' -o -iname '*.xml' \) -print0 2>/dev/null \
    | while IFS= read -r -d '' _path; do
        printf '.\n'
      done \
    | wc -l \
    | tr -d ' '
}

count_reference_assets() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/references" "$dir/design/mocks" "$dir/design/screenshots"
}

count_reference_links() {
  local path="$1/design/reference-links.md"
  if [[ ! -f "$path" ]]; then
    echo 0
    return
  fi
  awk '
    /^## References/ { found = 1; next }
    found && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#/ && $0 !~ /^<!--/ { count++ }
    END { print count + 0 }
  ' "$path"
}

count_visual_screenshots() {
  local dir="$1"
  count_supported_artifacts image "$dir/reviews/visual-screenshots"
}

count_design_mockups() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/mocks"
}

count_approved_design_artifacts() {
  local dir="$1"
  count_supported_artifacts image "$dir/design/approved"
}

is_formal_design_artifact() {
  local path="$1"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$mime" in
      image/svg+xml|text/xml|application/xml) return 1 ;;
      image/*|application/pdf) return 0 ;;
    esac
    return 1
  fi
  case "$path" in
    *.[Pp][Nn][Gg]|*.[Jj][Pp][Gg]|*.[Jj][Pp][Ee][Gg]|*.[Ww][Ee][Bb][Pp]|*.[Gg][Ii][Ff]|*.[Hh][Ee][Ii][Cc]|*.[Pp][Dd][Ff]) return 0 ;;
  esac
  return 1
}

count_final_design_artifacts() {
  local dir="$1"
  local existing=()
  local candidate
  for candidate in "$dir/design/approved"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_formal_design_artifact "$path"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_cut_assets() {
  local dir="$1"
  count_supported_artifacts cut "$dir/design/cut-assets"
}

cut_asset_manifest_entries() {
  local path="$1/design/cut-assets/ASSET_MANIFEST.md"
  if [[ ! -f "$path" ]]; then
    echo 0
    return
  fi
  awk '
    /^\|/ && $0 !~ /^\|[[:space:]]*-+/ && $0 !~ /Asset[[:space:]]*\|[[:space:]]*Source approved asset/ {
      if ($0 ~ /design\/cut-assets\// || $0 ~ /apps\/[^|]*\/assets\// || $0 ~ /packages\/[^|]*\/assets\//) count++
    }
    END { print count + 0 }
  ' "$path"
}

cut_assets_declared_not_required() {
  local path="$1/design/cut-assets/ASSET_MANIFEST.md"
  [[ -f "$path" ]] || return 1
  grep -Eiq '(CUT_ASSETS_REQUIRED:[[:space:]]*(no|false|none|not required)|No cut assets required)' "$path"
}

mobile_app_has_custom_icon_assets() {
  local dir="$1"
  local app_json="$dir/apps/mobile/app.json"
  local assets_dir="$dir/apps/mobile/assets"
  [[ -f "$app_json" ]] || return 0
  [[ -s "$assets_dir/icon.png" && -s "$assets_dir/adaptive-icon.png" && -s "$assets_dir/splash-icon.png" ]] || return 1
  if command -v shasum >/dev/null 2>&1; then
    # Expo's template placeholder icon on this machine uses this exact hash.
    local placeholder_hash current_hash
    placeholder_hash="a3fb1e435d60ecd713a55e1f19a19739da7c5f96"
    current_hash="$(shasum "$assets_dir/icon.png" | awk '{print $1}')"
    [[ "$current_hash" != "$placeholder_hash" ]] || return 1
  fi
  return 0
}

trim_md_cell() {
  printf '%s' "${1:-}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/^`//; s/`$//'
}

has_md_heading() {
  local path="$1"
  local heading="$2"
  [[ -f "$path" ]] || return 1
  grep -Eiq "^##[[:space:]]+${heading}([[:space:]]*$|[[:space:]]|:)" "$path"
}

has_md_heading_alias() {
  local path="$1"
  local aliases="$2"
  local alias
  local -a heading_aliases
  IFS='|' read -r -a heading_aliases <<< "$aliases"
  for alias in "${heading_aliases[@]}"; do
    if has_md_heading "$path" "$alias"; then
      return 0
    fi
  done
  return 1
}

check_required_headings() {
  local path="$1"
  local label="$2"
  shift 2
  local heading failures
  failures=0
  for heading in "$@"; do
    if ! has_md_heading "$path" "$heading"; then
      echo "Missing required section in $label: ## $heading" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

check_required_heading_aliases() {
  local path="$1"
  local label="$2"
  shift 2
  local aliases display failures
  failures=0
  for aliases in "$@"; do
    display="${aliases%%|*}"
    if ! has_md_heading_alias "$path" "$aliases"; then
      echo "Missing required section in $label: ## $display" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

pdca_section_has_evidence() {
  local path="$1"
  local heading="$2"
  [[ -f "$path" ]] || return 1
  awk -v target="$heading" '
    BEGIN { found = 0; in_section = 0 }
    /^##[[:space:]]+/ {
      current = $0
      sub(/^##[[:space:]]+/, "", current)
      gsub(/[[:space:]]+$/, "", current)
      in_section = (tolower(current) == tolower(target))
      next
    }
    in_section {
      line = $0
      gsub(/^[[:space:]]*-[[:space:]]*/, "", line)
      gsub(/^[[:space:]]+/, "", line)
      gsub(/[[:space:]]+$/, "", line)
      if (line == "" || line ~ /^<!--/) next
      if (line ~ /^[^:]+:[[:space:]]*$/) next
      found = 1
    }
    END { exit found ? 0 : 1 }
  ' "$path"
}

check_design_package_structure() {
  local dir="$1"
  local failures
  failures=0
  check_required_heading_aliases "$dir/design/DESIGN.md" "design/DESIGN.md" \
    "UX Problem|UX 问题" "Recommended Direction|推荐方向" "Alternatives Considered|备选方案" \
    "Information Architecture|信息架构" "Interaction Model|交互模型" "Visual System|视觉系统" \
    "Design Artifacts|设计产物" "Build Implications|实施影响" || failures=$((failures + 1))
  check_required_heading_aliases "$dir/design/VISUAL_SYSTEM.md" "design/VISUAL_SYSTEM.md" \
    "Reference Influence|参考影响" "Palette|色彩" "Typography|字体|字体与文字|排版" \
    "Spacing and Layout|间距与布局" "Components and Motion|组件与动效|组件" \
    "Forbidden Patterns|禁止模式|禁用模式" || failures=$((failures + 1))
  check_screen_acceptance_structure "$dir" || failures=$((failures + 1))
  [[ "$failures" -eq 0 ]]
}

required_design_screens() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 0
  awk '
    /^##[[:space:]]+/ {
      sub(/^##[[:space:]]+/, "")
      gsub(/[[:space:]]+$/, "")
      if ($0 != "") print
    }
  ' "$path"
}

design_artifact_ledger_path() {
  local dir="$1"
  printf '%s/design/DESIGN_ARTIFACTS.md' "$dir"
}

design_image_description_ledger_path() {
  local dir="$1"
  printf '%s/design/DESIGN_IMAGE_DESCRIPTIONS.md' "$dir"
}

design_artifacts_has_header() {
  local dir="$1"
  local path
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*State[[:space:]]*\|[[:space:]]*Source type[[:space:]]*\|[[:space:]]*Source reference[[:space:]]*\|[[:space:]]*Approved asset path[[:space:]]*\|[[:space:]]*Resolution / export[[:space:]]*\|[[:space:]]*Status[[:space:]]*\|[[:space:]]*Implementation notes[[:space:]]*\|[[:space:]]*$' "$path"
}

is_forbidden_design_source() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *screenshot*|*screencap*|*screencapture*|*snapshot*|*capture*|*playwright*|*puppeteer*|*chrome*|*localhost*|*browser*|*simulator*|*runtime*|*render*|*rasteriz*|*html-to-image*|*html2canvas*|*canvas*|*svg*|*design/drafts*|*design/mocks*|*design/screenshots*|*reviews/visual-screenshots*|*apps/*|*prototype*|*wireframe*|*sketch*|*draft*|*草图*|*原型*|*截图*|*截屏*|*渲染*)
      return 1
      ;;
  esac
  return 0
}

is_allowed_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    imagegen|gpt-image-2|gpt-image|figma|figma-mcp|designer-upload|uploaded-approved|design-system|external-design)
      return 0
      ;;
    *screenshot*|*screencap*|*capture*|*playwright*|*puppeteer*|*chrome*|*browser*|*simulator*|*runtime*|*render*|*rasteriz*|*html*|*canvas*|*svg*|*draft*|*prototype*|*wireframe*|*sketch*|*manual*|*local*|*草图*|*原型*|*截图*|*渲染*)
      return 1
      ;;
  esac
  return 1
}

is_valid_formal_design_source_ref() {
  local source_type="$1"
  local source_ref="$2"
  local lower_type lower_ref
  source_ref="$(trim_md_cell "$source_ref")"
  lower_type="$(printf '%s' "$source_type" | tr '[:upper:]' '[:lower:]')"
  lower_ref="$(printf '%s' "$source_ref" | tr '[:upper:]' '[:lower:]')"
  [[ -n "$source_ref" && "$source_ref" != "-" && "$source_ref" != "TBD" && "$source_ref" != "TODO" ]] || return 1
  is_forbidden_design_source "$source_ref" || return 1
  case "$lower_type" in
    imagegen) [[ "$lower_ref" == imagegen://* ]] ;;
    gpt-image) [[ "$lower_ref" == gpt-image://* ]] ;;
    gpt-image-2) [[ "$lower_ref" == gpt-image-2://* ]] ;;
    figma|figma-mcp) is_valid_figma_source_ref "$source_ref" ;;
    designer-upload|uploaded-approved)
      [[ "$lower_ref" == upload://* || "$lower_ref" == designer-upload://* || "$lower_ref" == design/sources/uploads/* || "$lower_ref" == ./design/sources/uploads/* ]]
      ;;
    design-system)
      [[ "$lower_ref" == design-system://* || "$lower_ref" == component-library://* || "$lower_ref" == token://* || "$lower_ref" == design/sources/design-system/* || "$lower_ref" == ./design/sources/design-system/* ]]
      ;;
    external-design)
      [[ "$lower_ref" == external-design://* || "$lower_ref" == approved://* || "$lower_ref" == design/sources/approved/* || "$lower_ref" == ./design/sources/approved/* ]]
      ;;
    *) return 1 ;;
  esac
}

is_project_approved_design_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  case "$saved_path" in
    design/approved/*|./design/approved/*)
      [[ "$full_path" == "$dir/"* ]]
      ;;
    /*)
      [[ "$full_path" == "$dir/design/approved/"* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

is_figma_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    figma|figma-mcp) return 0 ;;
    *) return 1 ;;
  esac
}

is_ai_generated_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    imagegen|gpt-image|gpt-image-2) return 0 ;;
    *) return 1 ;;
  esac
}

html_description_path_from_notes() {
  local raw="$1"
  printf '%s\n' "$raw" \
    | grep -Eo '(\./)?design/approved/html/[^[:space:]|,;)]*\.html' \
    | head -n 1 \
    | sed 's#^\./##'
}

is_project_html_description_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  case "$saved_path" in
    design/approved/html/*.html|./design/approved/html/*.html)
      [[ "$full_path" == "$dir/"* && -s "$full_path" ]]
      ;;
    /*)
      [[ "$full_path" == "$dir/design/approved/html/"*.html && -s "$full_path" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

image_html_description_mentions() {
  local dir="$1"
  local asset_path="$2"
  local html_path="$3"
  local path
  path="$(design_image_description_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Fq "$asset_path" "$path" && grep -Fq "$html_path" "$path"
}

is_missing_trace_value() {
  local raw lower
  raw="$(trim_md_cell "${1:-}")"
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    ""|"-"|"tbd"|"todo") return 0 ;;
    *) return 1 ;;
  esac
}

design_artifact_row_field_for_screen_asset() {
  local dir="$1"
  local screen="$2"
  local asset="$3"
  local field="$4"
  local path line in_coverage
  local screen_cell source_type_cell source_ref_cell asset_cell notes_cell
  local screen_name source_type source_ref asset_path notes html_path
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  in_coverage=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ source_type_cell source_ref_cell asset_cell _ _ notes_cell _ <<< "$line"
    screen_name="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    notes="$(trim_md_cell "$notes_cell")"
    [[ "$screen_name" == "$screen" && "$asset_path" == "$asset" ]] || continue
    case "$field" in
      source_type) printf '%s\n' "$source_type" ;;
      source_ref) printf '%s\n' "$source_ref" ;;
      html)
        if is_ai_generated_design_source_type "$source_type"; then
          html_path="$(html_description_path_from_notes "$notes" || true)"
          printf '%s\n' "$html_path"
        fi
        ;;
      *) return 1 ;;
    esac
    return 0
  done < "$path"
  return 1
}

is_valid_figma_source_ref() {
  local raw="$1"
  local lower
  raw="$(trim_md_cell "$raw")"
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  [[ -n "$raw" && "$raw" != "-" && "$raw" != "TBD" && "$raw" != "TODO" ]] || return 1
  case "$lower" in
    figma://*|https://figma.com/*|https://www.figma.com/*) return 0 ;;
    *) return 1 ;;
  esac
}

count_figma_design_artifact_rows() {
  local dir="$1"
  local path line source_type_cell source_type rows in_coverage
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || { echo 0; return; }
  rows=0
  in_coverage=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ _ _ source_type_cell _ _ _ _ _ <<< "$line"
    source_type="$(trim_md_cell "$source_type_cell")"
    if is_figma_design_source_type "$source_type"; then
      rows=$((rows + 1))
    fi
  done < "$path"
  echo "$rows"
}

figma_handoff_path() {
  local dir="$1"
  printf '%s/design/FIGMA_HANDOFF.md' "$dir"
}

figma_handoff_mentions() {
  local dir="$1"
  local source_ref="$2"
  local asset_path="$3"
  local path
  path="$(figma_handoff_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Fq "$source_ref" "$path" && grep -Fq "$asset_path" "$path"
}

check_design_artifact_contract() {
  local dir="$1"
  local path
  local line in_coverage rows failures
  local screen_cell state_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell notes_cell
  local screen source_type source_ref asset_path asset_full_path resolution status notes html_path html_full_path
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  failures=0
  rows=0
  in_coverage=false
  if ! design_artifacts_has_header "$dir"; then
    echo "Missing formal design artifact columns in design/DESIGN_ARTIFACTS.md: Screen Coverage must use '| Screen | State | Source type | Source reference | Approved asset path | Resolution / export | Status | Implementation notes |'." >&2
    failures=$((failures + 1))
  fi
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell state_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell notes_cell _ <<< "$line"
    screen="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    resolution="$(trim_md_cell "$resolution_cell")"
    status="$(trim_md_cell "$status_cell")"
    notes="$(trim_md_cell "$notes_cell")"
    [[ -n "$screen" ]] || continue
    rows=$((rows + 1))
    if ! is_allowed_design_source_type "$source_type"; then
      echo "Invalid formal design source for screen: $screen (Source type must be a formal producer: imagegen, gpt-image, gpt-image-2, figma, figma-mcp, designer-upload, uploaded-approved, design-system, or external-design. Manual/local/rendered/screenshot sources are forbidden)." >&2
      failures=$((failures + 1))
    fi
    if ! is_valid_formal_design_source_ref "$source_type" "$source_ref"; then
      echo "Invalid design source reference for screen: $screen (record a formal producer reference such as imagegen://, gpt-image-2://, figma:// or Figma URL, upload://, designer-upload://, design-system://, external-design://, or design/sources/approved/. Do not use SVG/HTML renders, screenshots, browser captures, simulator captures, local app output, or prototype paths as development-ready design sources)." >&2
      failures=$((failures + 1))
    fi
    if [[ ! "$status" =~ [Aa]pproved|[Ff]inal|正式|批准|通过 ]]; then
      echo "Missing approved status for screen: $screen (Status must mark the asset as approved/final before implementation)." >&2
      failures=$((failures + 1))
    fi
    if [[ -z "$resolution" || "$resolution" == "-" || "$resolution" == "TBD" || "$resolution" == "TODO" ]]; then
      echo "Missing resolution/export note for screen: $screen (record viewport, Figma frame, export scale, or image dimensions)." >&2
      failures=$((failures + 1))
    fi
    case "$asset_path" in
      /*) asset_full_path="$asset_path" ;;
      *) asset_full_path="$dir/$asset_path" ;;
    esac
    if ! is_forbidden_design_source "$asset_path" || ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_design_artifact "$asset_full_path"; then
      echo "Invalid approved design asset for screen: $screen (Approved asset path must be a real raster/PDF under design/approved/, not a draft, screenshot, prototype, or runtime capture)." >&2
      failures=$((failures + 1))
    fi
    if is_ai_generated_design_source_type "$source_type"; then
      html_path="$(html_description_path_from_notes "$notes" || true)"
      if [[ -z "$html_path" ]]; then
        echo "Missing AI design HTML description for screen: $screen (Implementation notes must include a path such as 'HTML: design/approved/html/${screen}.html')." >&2
        failures=$((failures + 1))
      else
        case "$html_path" in
          /*) html_full_path="$html_path" ;;
          *) html_full_path="$dir/$html_path" ;;
        esac
        if ! is_project_html_description_path "$dir" "$html_path" "$html_full_path"; then
          echo "Invalid AI design HTML description for screen: $screen (HTML companion must be a real non-empty .html file under design/approved/html/)." >&2
          failures=$((failures + 1))
        fi
        if ! image_html_description_mentions "$dir" "$asset_path" "$html_path"; then
          echo "Missing AI design HTML description ledger row for screen: $screen (design/DESIGN_IMAGE_DESCRIPTIONS.md must map the approved image to the HTML companion)." >&2
          failures=$((failures + 1))
        fi
      fi
    fi
  done < "$path"
  if [[ "$rows" -eq 0 ]]; then
    echo "Missing formal design artifact rows: add at least one Screen Coverage row in design/DESIGN_ARTIFACTS.md." >&2
    failures=$((failures + 1))
  fi
  [[ "$failures" -eq 0 ]]
}

screen_has_approved_design_asset() {
  local dir="$1"
  local screen="$2"
  local ledger
  local line screen_cell path_cell screen_name saved_path full_path
  ledger="$(design_artifact_ledger_path "$dir")"
  [[ -f "$ledger" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ _ _ path_cell _ _ _ <<< "$line"
    screen_name="$(trim_md_cell "$screen_cell")"
    [[ "$screen_name" == "$screen" ]] || continue
    saved_path="$(trim_md_cell "$path_cell")"
    [[ -n "$saved_path" ]] || continue
    case "$saved_path" in
      /*) full_path="$saved_path" ;;
      *) full_path="$dir/$saved_path" ;;
    esac
    if is_project_approved_design_path "$dir" "$saved_path" "$full_path" && is_formal_design_artifact "$full_path"; then
      return 0
    fi
  done < "$ledger"
  return 1
}

check_screen_acceptance_structure() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 1
  awk '
    function flush() {
      if (screen == "") return
      if (!states || !breakpoints || !boards || !visual || !accessibility) {
        print "Incomplete screen acceptance section: " screen " (requires Required states, Breakpoints, Required design assets, Visual acceptance, and Accessibility acceptance)." > "/dev/stderr"
        failures++
      }
    }
    /^##[[:space:]]+/ {
      flush()
      screen = $0
      sub(/^##[[:space:]]+/, "", screen)
      gsub(/[[:space:]]+$/, "", screen)
      states = breakpoints = boards = visual = accessibility = 0
      seen = 1
      next
    }
    screen != "" {
      if ($0 ~ /(Required states|必备状态)[：:]/) states = 1
      if ($0 ~ /(Breakpoints|断点)[：:]/) breakpoints = 1
      if ($0 ~ /(Required design assets|Approved design assets|高保真参考图|设计板|正式设计图)[：:]/) boards = 1
      if ($0 ~ /(Visual acceptance|视觉验收)[：:]/) visual = 1
      if ($0 ~ /(Accessibility acceptance|无障碍验收)[：:]/) accessibility = 1
    }
    END {
      flush()
      if (!seen) {
        print "Missing screen acceptance headings: add one or more ## Screen Name sections to design/SCREEN_ACCEPTANCE.md." > "/dev/stderr"
        failures++
      }
      exit failures
    }
  ' "$path"
}

check_design_screen_coverage() {
  local dir="$1"
  local missing=0
  local required=0
  local screen
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! screen_has_approved_design_asset "$dir" "$screen"; then
      echo "Missing approved design asset for screen: $screen (add a raster/PDF path for this screen in design/DESIGN_ARTIFACTS.md)." >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  if [[ "$required" -eq 0 ]]; then
    echo "Missing screen acceptance headings: add one or more '## Screen Name' sections to design/SCREEN_ACCEPTANCE.md." >&2
    return 1
  fi
  [[ "$missing" -eq 0 ]]
}

check_visual_comparison_screen_coverage() {
  local dir="$1"
  local path="$dir/reviews/VISUAL_COMPARISON.md"
  local missing screen required
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! grep -Fq "$screen" "$path"; then
      echo "Missing visual comparison coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

plan_references_design_contract() {
  local dir="$1"
  local path="$dir/tasks/PLAN.md"
  [[ -f "$path" ]] || return 1
  grep -Eiq 'DESIGN\.md|VISUAL_SYSTEM\.md|SCREEN_ACCEPTANCE\.md|DESIGN_ARTIFACTS\.md|approved design|design/approved|VISUAL_COMPARISON' "$path"
}

delegated_reference_board_present() {
  local dir="$1"
  has_content "$dir/design/REFERENCE_BOARD.md"
}

check_implementation_trace_coverage() {
  local dir="$1"
  local path="$dir/tasks/IMPLEMENTATION_TRACE.md"
  local missing required line screen
  local screen_cell state_cell target_cell asset_cell design_source_cell html_cell cut_cell test_cell status_cell
  local target_path asset_path design_source html_companion cut_assets test_evidence status
  local asset_full_path html_full_path expected_source_type expected_source_ref expected_html
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  if ! grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*State[[:space:]]*\|[[:space:]]*Implementation target[[:space:]]*\|[[:space:]]*Approved asset[[:space:]]*\|[[:space:]]*Design source[[:space:]]*\|[[:space:]]*HTML companion[[:space:]]*\|[[:space:]]*Cut assets[[:space:]]*\|[[:space:]]*Test evidence[[:space:]]*\|[[:space:]]*Status[[:space:]]*\|[[:space:]]*$' "$path"; then
    echo "Missing implementation trace columns in tasks/IMPLEMENTATION_TRACE.md: use '| Screen | State | Implementation target | Approved asset | Design source | HTML companion | Cut assets | Test evidence | Status |'." >&2
    return 1
  fi
  while IFS= read -r screen; do
    required=$((required + 1))
    local found=0
    while IFS= read -r line; do
      [[ "$line" == \|* ]] || continue
      [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
      [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
      IFS='|' read -r _ screen_cell state_cell target_cell asset_cell design_source_cell html_cell cut_cell test_cell status_cell _ <<< "$line"
      [[ "$(trim_md_cell "$screen_cell")" == "$screen" ]] || continue
      target_path="$(trim_md_cell "$target_cell")"
      asset_path="$(trim_md_cell "$asset_cell")"
      design_source="$(trim_md_cell "$design_source_cell")"
      html_companion="$(trim_md_cell "$html_cell")"
      cut_assets="$(trim_md_cell "$cut_cell")"
      test_evidence="$(trim_md_cell "$test_cell")"
      status="$(trim_md_cell "$status_cell")"
      if is_missing_trace_value "$target_path" || is_missing_trace_value "$asset_path" || is_missing_trace_value "$design_source" || is_missing_trace_value "$cut_assets" || is_missing_trace_value "$test_evidence" || is_missing_trace_value "$status"; then
        echo "Incomplete implementation trace row for screen: $screen" >&2
        missing=$((missing + 1))
      fi
      case "$asset_path" in
        /*) asset_full_path="$asset_path" ;;
        *) asset_full_path="$dir/$asset_path" ;;
      esac
      if ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_design_artifact "$asset_full_path"; then
        echo "Invalid implementation trace approved asset for screen: $screen (Approved asset must be a real raster/PDF under design/approved/)." >&2
        missing=$((missing + 1))
      fi
      expected_source_type="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" source_type || true)"
      expected_source_ref="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" source_ref || true)"
      expected_html="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" html || true)"
      if [[ -z "$expected_source_type" || -z "$expected_source_ref" ]]; then
        echo "Missing design artifact mapping for implementation trace screen: $screen (Approved asset must match design/DESIGN_ARTIFACTS.md Screen Coverage)." >&2
        missing=$((missing + 1))
      elif [[ "$design_source" != *"$expected_source_ref"* ]]; then
        echo "Implementation trace design source mismatch for screen: $screen (Design source must reference $expected_source_ref)." >&2
        missing=$((missing + 1))
      fi
      if is_figma_design_source_type "$expected_source_type" && ! is_valid_figma_source_ref "$design_source"; then
        echo "Missing implementation trace Figma source for screen: $screen (Design source must be a figma://... reference or Figma URL)." >&2
        missing=$((missing + 1))
      fi
      if is_ai_generated_design_source_type "$expected_source_type"; then
        if [[ -z "$expected_html" || "$html_companion" != *"$expected_html"* ]]; then
          echo "Missing implementation trace HTML companion for screen: $screen (HTML companion must reference ${expected_html:-the HTML path from design/DESIGN_ARTIFACTS.md})." >&2
          missing=$((missing + 1))
        else
          case "$expected_html" in
            /*) html_full_path="$expected_html" ;;
            *) html_full_path="$dir/$expected_html" ;;
          esac
          if ! is_project_html_description_path "$dir" "$expected_html" "$html_full_path"; then
            echo "Invalid implementation trace HTML companion for screen: $screen (HTML companion must be a real non-empty .html file under design/approved/html/)." >&2
            missing=$((missing + 1))
          fi
        fi
      fi
      found=1
      break
    done < "$path"
    if [[ "$found" -eq 0 ]]; then
      echo "Missing implementation trace coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

check_visual_comparison_contract() {
  local dir="$1"
  local path="$dir/reviews/VISUAL_COMPARISON.md"
  local missing required line screen screen_cell asset_cell runtime_cell score_cell decision_cell full_path
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  if ! grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*Approved asset path[[:space:]]*\|[[:space:]]*Runtime surface[[:space:]]*\|[[:space:]]*Fidelity score[[:space:]]*\|[[:space:]]*Decision[[:space:]]*\|[[:space:]]*Notes[[:space:]]*\|[[:space:]]*$' "$path"; then
    echo "Missing visual comparison matrix columns in reviews/VISUAL_COMPARISON.md: use '| Screen | Approved asset path | Runtime surface | Fidelity score | Decision | Notes |'." >&2
    return 1
  fi
  while IFS= read -r screen; do
    required=$((required + 1))
    local found=0
    while IFS= read -r line; do
      [[ "$line" == \|* ]] || continue
      [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
      [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
      IFS='|' read -r _ screen_cell asset_cell runtime_cell score_cell decision_cell _ _ <<< "$line"
      [[ "$(trim_md_cell "$screen_cell")" == "$screen" ]] || continue
      asset_cell="$(trim_md_cell "$asset_cell")"
      runtime_cell="$(trim_md_cell "$runtime_cell")"
      score_cell="$(trim_md_cell "$score_cell")"
      decision_cell="$(trim_md_cell "$decision_cell")"
      case "$asset_cell" in
        /*) full_path="$asset_cell" ;;
        *) full_path="$dir/$asset_cell" ;;
      esac
      if [[ -z "$runtime_cell" || "$runtime_cell" == "-" || "$runtime_cell" == "TBD" || "$runtime_cell" == "TODO" || -z "$decision_cell" || "$decision_cell" == "-" || "$decision_cell" == "TBD" || "$decision_cell" == "TODO" || ! "$score_cell" =~ ^[0-9]+(/[0-9]+)?$ ]] || ! is_project_approved_design_path "$dir" "$asset_cell" "$full_path" || ! is_formal_design_artifact "$full_path"; then
        echo "Incomplete visual comparison row for screen: $screen" >&2
        missing=$((missing + 1))
      fi
      found=1
      break
    done < "$path"
    if [[ "$found" -eq 0 ]]; then
      echo "Missing visual comparison coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

asset_check_impl() {
  local project="$1"
  local dir failures design_assets final_design_assets cut_assets cut_manifest_entries forbidden_design_svgs
  require_project "$project"
  dir="$(project_path "$project")"
  failures=0
  load_project_applicability "$project"
  if ! setting_enabled "$UI_DESIGN_ASSETS"; then
    echo "Asset check skipped for $project: UI_DESIGN_ASSETS=$UI_DESIGN_ASSETS."
    return 0
  fi
  design_assets="$(count_approved_design_artifacts "$dir")"
  final_design_assets="$(count_final_design_artifacts "$dir")"
  forbidden_design_svgs="$(count_forbidden_svg_artifacts "$dir/design/approved")"
  if ! has_content "$dir/design/DESIGN_ARTIFACTS.md"; then
    echo "Missing or too thin: design/DESIGN_ARTIFACTS.md" >&2
    failures=$((failures + 1))
  fi
  if [[ -f "$dir/design/DESIGN_ARTIFACTS.md" ]] && ! check_design_artifact_contract "$dir"; then
    failures=$((failures + 1))
  fi
  if [[ "$forbidden_design_svgs" -gt 0 ]]; then
    echo "Forbidden SVG/XML file under design/approved/: keep SVG, Mermaid, and code-native sketches under design/drafts/ or design/mocks/; approved design boards must be raster/PDF exports." >&2
    failures=$((failures + 1))
  fi
  if [[ "$(count_invalid_approved_design_artifacts "$dir")" -gt 0 ]]; then
    echo "Invalid approved design artifact(s): files under design/approved/ must be real non-empty image/PDF files, not text placeholders." >&2
    failures=$((failures + 1))
  fi
  if [[ "$design_assets" -eq 0 ]]; then
    echo "Missing approved design assets: save 1-N formal layout/state images per UI screen under design/approved/ before implementation planning." >&2
    failures=$((failures + 1))
  fi
  if [[ "$final_design_assets" -eq 0 ]]; then
    echo "Missing final approved design asset: SVG/Mermaid/code-native drafts are structure drafts only, not implementation targets; design/approved/ must include at least one formal raster image or PDF." >&2
    failures=$((failures + 1))
  fi
  if ! check_design_screen_coverage "$dir"; then
    failures=$((failures + 1))
  fi
  cut_assets="$(count_cut_assets "$dir")"
  cut_manifest_entries="$(cut_asset_manifest_entries "$dir")"
  if [[ "$cut_assets" -gt 0 || "$cut_manifest_entries" -gt 0 ]]; then
    if [[ "$cut_assets" -eq 0 || "$cut_manifest_entries" -eq 0 ]]; then
      echo "Incomplete cut-asset manifest: files under design/cut-assets/ and rows in ASSET_MANIFEST.md must both exist when cut assets are required." >&2
      failures=$((failures + 1))
    fi
  elif ! cut_assets_declared_not_required "$dir"; then
    echo "Missing cut-asset decision: list required SVG/bitmap element assets in design/cut-assets/ASSET_MANIFEST.md or record 'CUT_ASSETS_REQUIRED: no' with rationale." >&2
    failures=$((failures + 1))
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Asset check failed for $project." >&2
    return 1
  fi
  echo "Asset check passed for $project with $design_assets approved design asset(s), including $final_design_assets final raster/PDF board(s)."
}

figma_check_impl() {
  local project="$1"
  local dir path line in_coverage rows failures
  local screen_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell
  local screen source_type source_ref asset_path resolution status asset_full_path
  require_project "$project"
  dir="$(project_path "$project")"
  path="$(design_artifact_ledger_path "$dir")"
  failures=0
  rows=0
  in_coverage=false
  load_project_applicability "$project"
  if setting_disabled "$UI_FIGMA_HANDOFF"; then
    echo "Figma handoff check skipped for $project: UI_FIGMA_HANDOFF=$UI_FIGMA_HANDOFF."
    return 0
  fi
  if [[ ! -f "$path" ]]; then
    if setting_enabled "$UI_FIGMA_HANDOFF"; then
      echo "Missing design artifact ledger: design/DESIGN_ARTIFACTS.md" >&2
      return 1
    fi
    echo "Figma handoff check skipped for $project: no DESIGN_ARTIFACTS.md ledger."
    return 0
  fi
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ source_type_cell source_ref_cell asset_cell resolution_cell status_cell _ _ <<< "$line"
    screen="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    resolution="$(trim_md_cell "$resolution_cell")"
    status="$(trim_md_cell "$status_cell")"
    [[ -n "$screen" ]] || continue
    is_figma_design_source_type "$source_type" || continue
    rows=$((rows + 1))
    if ! is_valid_figma_source_ref "$source_ref"; then
      echo "Missing Figma source reference for screen: $screen (use figma://... or a Figma URL with file/node context)." >&2
      failures=$((failures + 1))
    fi
    if [[ -z "$resolution" || "$resolution" == "-" || "$resolution" == "TBD" || "$resolution" == "TODO" ]]; then
      echo "Missing Figma export detail for screen: $screen (record frame size, node, export scale, and format)." >&2
      failures=$((failures + 1))
    fi
    if [[ ! "$status" =~ [Aa]pproved|[Ff]inal|正式|批准|通过 ]]; then
      echo "Missing approved Figma handoff status for screen: $screen." >&2
      failures=$((failures + 1))
    fi
    case "$asset_path" in
      /*) asset_full_path="$asset_path" ;;
      *) asset_full_path="$dir/$asset_path" ;;
    esac
    if ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_design_artifact "$asset_full_path"; then
      echo "Invalid Figma approved export for screen: $screen (export must be a real raster/PDF under design/approved/)." >&2
      failures=$((failures + 1))
    fi
    if is_valid_figma_source_ref "$source_ref" && is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" && ! figma_handoff_mentions "$dir" "$source_ref" "$asset_path"; then
      echo "Missing Figma handoff ledger row for screen: $screen (design/FIGMA_HANDOFF.md must mention the Figma source and approved export)." >&2
      failures=$((failures + 1))
    fi
  done < "$path"
  if [[ "$rows" -eq 0 ]]; then
    if setting_enabled "$UI_FIGMA_HANDOFF"; then
      echo "Missing Figma handoff rows: add figma or figma-mcp Screen Coverage rows in design/DESIGN_ARTIFACTS.md." >&2
      failures=$((failures + 1))
    else
      echo "Figma handoff check skipped for $project: no Figma-backed design artifact rows."
      return 0
    fi
  fi
  if [[ "$rows" -gt 0 ]]; then
    if ! has_content "$(figma_handoff_path "$dir")"; then
      echo "Missing or too thin: design/FIGMA_HANDOFF.md" >&2
      failures=$((failures + 1))
    fi
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Figma handoff check failed for $project." >&2
    return 1
  fi
  echo "Figma handoff check passed for $project with $rows Figma-backed design artifact row(s)."
}

count_invalid_approved_design_artifacts() {
  local dir="$1"
  count_unsupported_artifacts image "$dir/design/approved"
}

count_cut_assets() {
  local dir="$1"
  count_supported_artifacts cut "$dir/design/cut-assets"
}

has_content() {
  local path="$1"
  [[ -s "$path" ]] && [[ "$(wc -l < "$path" | tr -d ' ')" -ge 5 ]]
}

load_project_applicability() {
  local path
  load_project_schema "${1:-}"
  PM_FLOW="auto"
  AGENT_FLOW="auto"
  case "$PROJECT_TYPE" in
    agent)
      AGENT_FLOW="required"
      UI_FLOW="disabled"
      UI_REFERENCES="disabled"
      UI_DESIGN_ASSETS="disabled"
      UI_FIGMA_HANDOFF="disabled"
      UI_MOCKUPS="disabled"
      ;;
    api|library|docs)
      UI_FLOW="disabled"
      UI_REFERENCES="disabled"
      UI_DESIGN_ASSETS="disabled"
      UI_FIGMA_HANDOFF="disabled"
      UI_MOCKUPS="disabled"
      ;;
    *)
      UI_FLOW="required"
      UI_REFERENCES="required"
      UI_DESIGN_ASSETS="required"
      UI_FIGMA_HANDOFF="auto"
      UI_MOCKUPS="auto"
      ;;
  esac
  GIT_CHECKPOINTS="auto"
  path="$(applicability_path "${1:-}")"
  if [[ -f "$path" ]]; then
    # shellcheck disable=SC1090
    source "$path"
  fi
}

setting_enabled() {
  case "${1:-}" in
    required|enabled|true|yes|1) return 0 ;;
    *) return 1 ;;
  esac
}

setting_disabled() {
  case "${1:-}" in
    disabled|false|no|0|skip|off) return 0 ;;
    *) return 1 ;;
  esac
}

setting_delegated() {
  case "${1:-}" in
    delegated|delegate|user-delegated|visual-direction-delegated) return 0 ;;
    *) return 1 ;;
  esac
}

references_required_loaded() {
  setting_disabled "$UI_REFERENCES" && return 1
  setting_delegated "$UI_REFERENCES" && return 1
  return 0
}

references_required() {
  load_project_applicability "$1"
  references_required_loaded
}

has_phase_artifact() {
  local project="$1"
  local phase="$2"
  local dir
  dir="$(project_path "$project")"
  case "$phase" in
    pm)
      [[ -s "$dir/product/PRD.md" || -s "$dir/product/USER_STORIES.md" || -s "$dir/product/ACCEPTANCE.md" || -s "$dir/product/METRICS.md" ]]
      ;;
    agent)
      [[ -s "$dir/agent/AGENT_SPEC.md" || -s "$dir/agent/WORKFLOW.md" || -s "$dir/agent/TOOLS_AND_PERMISSIONS.md" || -s "$dir/agent/PROMPTS_AND_SKILLS.md" || -s "$dir/agent/EVALS.md" || -s "$dir/agent/FAILURE_RECOVERY.md" || -s "$dir/agent/OPERATIONS.md" ]]
      ;;
    design)
      [[ -s "$dir/design/DESIGN.md" || -s "$dir/design/VISUAL_SYSTEM.md" || -s "$dir/design/SCREEN_ACCEPTANCE.md" ]] && return 0
      [[ "$(count_reference_assets "$dir")" -gt 0 || "$(count_reference_links "$dir")" -gt 0 || "$(count_design_mockups "$dir")" -gt 0 || "$(count_approved_design_artifacts "$dir")" -gt 0 ]]
      ;;
    *)
      return 1
      ;;
  esac
}

phase_is_applicable() {
  local project="$1"
  local phase="$2"
  load_project_applicability "$project"
  case "$phase" in
    idea|spec|plan|build|test|review|ship)
      return 0
      ;;
    pm)
      setting_disabled "$PM_FLOW" && return 1
      setting_enabled "$PM_FLOW" && return 0
      has_phase_artifact "$project" pm
      ;;
    agent)
      setting_disabled "$AGENT_FLOW" && return 1
      setting_enabled "$AGENT_FLOW" && return 0
      has_phase_artifact "$project" agent
      ;;
    design)
      setting_disabled "$UI_FLOW" && return 1
      setting_enabled "$UI_FLOW" && return 0
      has_phase_artifact "$project" design
      ;;
    *)
      return 1
      ;;
  esac
}

phase_index() {
  case "${1:-}" in
    idea) echo 0 ;;
    pm) echo 1 ;;
    agent) echo 2 ;;
    spec) echo 3 ;;
    design) echo 4 ;;
    plan) echo 5 ;;
    build) echo 6 ;;
    test) echo 7 ;;
    review) echo 8 ;;
    ship) echo 9 ;;
    *) echo -1 ;;
  esac
}

verify_prior_applicable_phases() {
  local project="$1"
  local phase="$2"
  local target_idx candidate candidate_idx failures
  target_idx="$(phase_index "$phase")"
  failures=0
  for candidate in idea pm agent spec design plan build test review ship; do
    candidate_idx="$(phase_index "$candidate")"
    if [[ "$candidate_idx" -ge 0 && "$candidate_idx" -lt "$target_idx" ]]; then
      if phase_is_applicable "$project" "$candidate"; then
        echo "Verifying prior phase before entering $phase: $candidate"
        if ! verify_phase_impl "$project" "$candidate"; then
          failures=$((failures + 1))
        fi
      fi
    fi
  done
  [[ "$failures" -eq 0 ]]
}

record_verification() {
  local project="$1"
  local text="$2"
  load_project_state "$project"
  write_project_state "$project" "$CURRENT_PHASE" "$CURRENT_TASK" "$BLOCKERS" "$text"
}

set_project_applicability() {
  local project="$1"
  local key="$2"
  local value="$3"
  local path tmp
  path="$(applicability_path "$project")"
  mkdir -p "$(dirname "$path")"
  tmp="$path.tmp"
  if [[ -f "$path" && "$(grep -c "^$key=" "$path" || true)" -gt 0 ]]; then
    awk -v key="$key" -v value="$value" '
      $0 ~ "^" key "=" { print key "=\"" value "\""; next }
      { print }
    ' "$path" > "$tmp"
    mv "$tmp" "$path"
  else
    printf '%s="%s"\n' "$key" "$value" >> "$path"
  fi
}

require_content_file() {
  local dir="$1"
  local rel="$2"
  if ! has_content "$dir/$rel"; then
    echo "Missing or too thin: $rel" >&2
    return 1
  fi
}

require_any_file() {
  local dir="$1"
  local label="$2"
  shift 2
  local pattern
  for pattern in "$@"; do
    if find "$dir" -path "$dir/$pattern" -type f 2>/dev/null | grep -q .; then
      return 0
    fi
  done
  echo "Missing evidence: $label" >&2
  return 1
}

visual_score() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  sed -nE 's/.*Overall score:[[:space:]]*([0-9][0-9]?[0-9]?)\/100.*/\1/p' "$path" | head -n 1
}

qa_exception_recorded() {
  local dir="$1"
  [[ -f "$dir/reviews/EXCEPTION.md" || -f "$dir/reviews/BLOCKED_FLOW.md" ]]
}

verify_phase_impl() {
  local project="$1"
  local phase="$2"
  require_project "$project"
  if ! is_valid_phase "$phase"; then
    echo "Invalid phase: ${phase:-<missing>}" >&2
    return 1
  fi
  local dir failures assets links mockups design_assets final_design_assets screenshots cut_assets cut_manifest_entries java_sources
  dir="$(project_path "$project")"
  failures=0
  case "$phase" in
    idea)
      require_content_file "$dir" "ideas/idea-brief.md" || failures=$((failures + 1))
      ;;
    pm)
      for file in product/PRD.md product/USER_STORIES.md product/ACCEPTANCE.md product/METRICS.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      ;;
    agent)
      for file in agent/AGENT_SPEC.md agent/WORKFLOW.md agent/TOOLS_AND_PERMISSIONS.md agent/PROMPTS_AND_SKILLS.md agent/EVALS.md agent/FAILURE_RECOVERY.md agent/OPERATIONS.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      ;;
    spec)
      require_content_file "$dir" "specs/SPEC.md" || failures=$((failures + 1))
      ;;
    design)
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      mockups="$(count_design_mockups "$dir")"
      if references_required "$project" && [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or reference links before design verification." >&2
        failures=$((failures + 1))
      fi
      load_project_applicability "$project"
      if setting_delegated "$UI_REFERENCES" && ! delegated_reference_board_present "$dir"; then
        echo "Missing delegated reference board: create design/REFERENCE_BOARD.md before using delegated visual direction." >&2
        failures=$((failures + 1))
      fi
      if setting_enabled "$UI_DESIGN_ASSETS"; then
        asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
      fi
      if setting_enabled "$UI_FIGMA_HANDOFF" || [[ "$(count_figma_design_artifact_rows "$dir")" -gt 0 ]]; then
        figma_check_impl "$project" >/dev/null || failures=$((failures + 1))
      fi
      if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
        echo "Missing design mockups: add image/SVG/PDF/Figma artifacts under design/mocks/." >&2
        failures=$((failures + 1))
      fi
      for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      if ! check_design_package_structure "$dir"; then
        failures=$((failures + 1))
      fi
      ;;
    plan)
      for file in tasks/PLAN.md tasks/quality-gates.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      if phase_is_applicable "$project" design && ! plan_references_design_contract "$dir"; then
        echo "Missing design handoff in tasks/PLAN.md: reference DESIGN.md, SCREEN_ACCEPTANCE.md, DESIGN_ARTIFACTS.md, approved design assets, or visual comparison criteria before UI implementation." >&2
        failures=$((failures + 1))
      fi
      if phase_is_applicable "$project" design; then
        require_content_file "$dir" "tasks/IMPLEMENTATION_TRACE.md" || failures=$((failures + 1))
        if [[ -f "$dir/tasks/IMPLEMENTATION_TRACE.md" ]] && ! check_implementation_trace_coverage "$dir"; then
          failures=$((failures + 1))
        fi
      fi
      ;;
    build)
      require_any_file "$dir" "implemented source under apps/ or packages/" "apps/*" "packages/*" || failures=$((failures + 1))
      if [[ -d "$dir/apps/android" ]]; then
        [[ -f "$dir/apps/android/settings.gradle.kts" || -f "$dir/apps/android/settings.gradle" ]] || { echo "Missing Android settings.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$dir/apps/android/app/build.gradle.kts" || -f "$dir/apps/android/app/build.gradle" ]] || { echo "Missing Android app build.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$dir/apps/android/app/src/main/AndroidManifest.xml" ]] || { echo "Missing AndroidManifest.xml." >&2; failures=$((failures + 1)); }
        java_sources="$(find "$dir/apps/android/app/src/main" -type f \( -name '*.java' -o -name '*.kt' \) 2>/dev/null | wc -l | tr -d ' ')"
        [[ "$java_sources" -gt 0 ]] || { echo "Missing Android Java/Kotlin sources." >&2; failures=$((failures + 1)); }
      fi
      ;;
    test)
      if [[ -d "$dir/apps/android" ]] && { ! command -v java >/dev/null 2>&1 || ! command -v gradle >/dev/null 2>&1; }; then
        require_content_file "$dir" "reviews/BLOCKED_BUILD.md" || failures=$((failures + 1))
      else
        if [[ ! -f "$dir/reviews/VERIFICATION.md" && ! -f "$dir/reviews/BLOCKED_BUILD.md" ]]; then
          echo "Missing verification evidence: add reviews/VERIFICATION.md or reviews/BLOCKED_BUILD.md." >&2
          failures=$((failures + 1))
        fi
      fi
      ;;
    review)
      require_content_file "$dir" "reviews/REVIEW.md" || failures=$((failures + 1))
      ;;
    ship)
      require_content_file "$dir" "ship/LAUNCH.md" || failures=$((failures + 1))
      ;;
  esac
  if [[ "$failures" -gt 0 ]]; then
    echo "Phase verification failed: $project/$phase" >&2
    return 1
  fi
  echo "Phase verification passed: $project/$phase"
}

qa_check_impl() {
  local project="$1"
  local dir failures mockups design_assets final_design_assets screenshots score cut_assets cut_manifest_entries
  require_project "$project"
  dir="$(project_path "$project")"
  failures=0
  for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md reviews/VISUAL_COMPARISON.md; do
    if ! has_content "$dir/$file"; then
      echo "Missing or too thin: $file" >&2
      failures=$((failures + 1))
    fi
  done
  mockups="$(count_design_mockups "$dir")"
  design_assets="$(count_approved_design_artifacts "$dir")"
  screenshots="$(count_visual_screenshots "$dir")"
  load_project_applicability "$project"
  if setting_enabled "$UI_DESIGN_ASSETS"; then
    asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
  fi
  if ! mobile_app_has_custom_icon_assets "$dir"; then
    echo "Missing custom mobile app icons: apps/mobile/assets/icon.png, adaptive-icon.png, and splash-icon.png must exist and not be Expo placeholders." >&2
    failures=$((failures + 1))
  fi
  if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
    echo "Missing design mockup evidence under design/mocks/." >&2
    failures=$((failures + 1))
  fi
  score="$(visual_score "$dir/reviews/VISUAL_COMPARISON.md" || true)"
  if [[ -z "$score" ]]; then
    echo "Missing visual comparison score: add 'Overall score: N/100' to reviews/VISUAL_COMPARISON.md." >&2
    failures=$((failures + 1))
  elif [[ "$score" -gt 100 ]]; then
    echo "Visual comparison score out of range: $score/100." >&2
    failures=$((failures + 1))
  elif [[ "$score" -lt 90 ]]; then
    echo "Visual comparison score too low: $score/100, expected at least 90/100 for high-fidelity UI delivery." >&2
    failures=$((failures + 1))
  fi
  check_required_headings "$dir/reviews/VISUAL_COMPARISON.md" "reviews/VISUAL_COMPARISON.md" \
    "Compared Inputs" "Screen Fidelity Matrix" "Score Breakdown" "Differences" "Decision" || failures=$((failures + 1))
  if phase_is_applicable "$project" design && ! check_visual_comparison_contract "$dir"; then
    failures=$((failures + 1))
  fi
  if qa_exception_recorded "$dir"; then
    if [[ "$screenshots" -eq 0 && ! -s "$dir/reviews/BLOCKED_SCREENSHOT.md" ]]; then
      echo "Exception or blocked-flow record found; add screenshot evidence under reviews/visual-screenshots/ or document why capture is impossible in reviews/BLOCKED_SCREENSHOT.md." >&2
      failures=$((failures + 1))
    fi
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "QA check failed for $project." >&2
    return 1
  fi
  echo "QA check passed for $project with $design_assets approved design asset(s), visual score ${score:-n/a}/100, functional test evidence, and monkey test evidence."
  if [[ "$screenshots" -eq 0 ]]; then
    echo "No exception or blocked flow recorded; runtime screenshots were not required."
  else
    echo "Runtime screenshot artifacts found: $screenshots."
  fi
}

pdca_check_impl() {
  local project="$1"
  local dir path failures
  require_project "$project"
  dir="$(project_path "$project")"
  path="$dir/tasks/PDCA.md"
  failures=0

  require_content_file "$dir" "tasks/PDCA.md" || failures=$((failures + 1))
  if [[ -f "$path" ]]; then
    check_required_headings "$path" "tasks/PDCA.md" "Current Cycle" "Plan" "Do" "Check" "Act" || failures=$((failures + 1))
    if ! pdca_section_has_evidence "$path" "Current Cycle"; then
      echo "Missing Current Cycle evidence in tasks/PDCA.md: fill the section with cycle scope, owner, date, or checkpoint." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Plan"; then
      echo "Missing Plan section evidence in tasks/PDCA.md: fill the section with concrete objective, source artifacts, acceptance criteria, or gates." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Do"; then
      echo "Missing Do section evidence in tasks/PDCA.md: fill the section with implemented slices, changed areas, or build artifacts." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Check"; then
      echo "Missing Check section evidence in tasks/PDCA.md: fill the section with verification, functional, monkey, or visual QA results." >&2
      failures=$((failures + 1))
    fi
    if ! pdca_section_has_evidence "$path" "Act"; then
      echo "Missing Act section evidence in tasks/PDCA.md: fill the section with decision, standardization, follow-up, or rollback notes." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'cycle|scope|SPEC\.md|DESIGN\.md|SCREEN_ACCEPTANCE\.md|PLAN\.md|acceptance|objective|hypothesis|quality gate|checkpoint|周期|范围|目标|验收|假设|质量|门禁|检查点' "$path"; then
      echo "Missing Plan evidence in tasks/PDCA.md: cite objective, acceptance criteria, source artifacts, or quality gates." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'build|implementation|implemented|task|slice|apps/|packages/|changed|commit|实现|开发|任务|切片|变更|构建|产物|提交' "$path"; then
      echo "Missing Do evidence in tasks/PDCA.md: record implementation slices, changed areas, or build artifacts." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'VERIFICATION\.md|FUNCTIONAL_TEST\.md|MONKEY_TEST\.md|VISUAL_COMPARISON\.md|test|qa-check|ship-check|score|verification|验证|功能|测试|视觉|评分|检查|证据' "$path"; then
      echo "Missing Check evidence in tasks/PDCA.md: record verification, functional tests, monkey tests, and QA evidence." >&2
      failures=$((failures + 1))
    fi
    if ! grep -Eiq 'decision|standardize|iterate|rollback|follow-up|next cycle|adjust|lesson|决定|决策|标准化|迭代|回滚|跟进|下一轮|调整|经验' "$path"; then
      echo "Missing Act evidence in tasks/PDCA.md: record the decision, follow-up, rollback, standardization, or next-cycle adjustment." >&2
      failures=$((failures + 1))
    fi
    if phase_is_applicable "$project" design && ! grep -Eiq 'VISUAL_COMPARISON\.md|visual comparison|DESIGN_ARTIFACTS\.md|approved design|90/100|score|视觉对比|正式设计|设计资产|评分' "$path"; then
      echo "Missing UI Check evidence in tasks/PDCA.md: link approved design assets and visual comparison score for customer-facing UI." >&2
      failures=$((failures + 1))
    fi
  fi

  if [[ "$failures" -gt 0 ]]; then
    echo "PDCA check failed for $project." >&2
    return 1
  fi
  echo "PDCA check passed for $project."
}

env_status_is_positive() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    satisfied|installed|available|approved|ok|pass|passed|not-required|not\ required|not-needed|not\ needed|n/a|none) return 0 ;;
    *) return 1 ;;
  esac
}

env_status_is_blocked() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    ""|todo|tbd|unknown|missing|blocked|failed|fail|pending|needs-approval|needs\ approval|requires-approval|requires\ approval) return 0 ;;
    *) return 1 ;;
  esac
}

env_required_is_yes() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    yes|true|required|y) return 0 ;;
    *) return 1 ;;
  esac
}

env_check_impl() {
  local project="$1"
  local dir path failures rows line capability scope required_by verify_cmd required permission status notes in_requirements
  require_project "$project"
  dir="$(project_path "$project")"
  path="$dir/.dev-flow/HOST_REQUIREMENTS.md"
  failures=0
  rows=0

  if [[ ! -f "$path" ]]; then
    echo "Missing host environment contract: .dev-flow/HOST_REQUIREMENTS.md" >&2
    echo "Run: bin/dev-flow migrate $project" >&2
    return 1
  fi

  if ! grep -Eq '^##[[:space:]]+Requirements' "$path"; then
    echo "Missing Requirements section in .dev-flow/HOST_REQUIREMENTS.md" >&2
    failures=$((failures + 1))
  fi

  in_requirements="false"
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Requirements ]]; then
      in_requirements="true"
      continue
    fi
    if [[ "$line" =~ ^##[[:space:]]+ && "$in_requirements" == "true" ]]; then
      in_requirements="false"
    fi
    [[ "$in_requirements" == "true" ]] || continue
    [[ "$line" == \|* ]] || continue
    [[ "$line" =~ ^\|[[:space:]]*- ]] && continue
    IFS='|' read -r _ capability scope required_by verify_cmd required permission status notes _ <<< "$line"
    capability="$(trim_md_cell "$capability")"
    scope="$(trim_md_cell "$scope")"
    required_by="$(trim_md_cell "$required_by")"
    verify_cmd="$(trim_md_cell "$verify_cmd")"
    required="$(trim_md_cell "$required")"
    permission="$(trim_md_cell "$permission")"
    status="$(trim_md_cell "$status")"
    notes="$(trim_md_cell "$notes")"

    [[ -n "$capability" ]] || continue
    [[ "$(printf '%s' "$capability" | tr '[:upper:]' '[:lower:]')" == "capability" ]] && continue
    rows=$((rows + 1))

    if [[ "$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]')" == *work* || "$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]')" == project-runtime ]]; then
      echo "Invalid host requirement scope for $capability: host SDKs/CLIs must not be scoped to work/<project> runtime output." >&2
      failures=$((failures + 1))
    fi

    if env_status_is_blocked "$status"; then
      echo "Blocked host requirement: $capability (status: ${status:-missing}; required by: ${required_by:-unspecified})." >&2
      failures=$((failures + 1))
      continue
    fi

    if env_required_is_yes "$required"; then
      if [[ -z "$verify_cmd" || "$(printf '%s' "$verify_cmd" | tr '[:upper:]' '[:lower:]')" == "todo" || "$(printf '%s' "$verify_cmd" | tr '[:upper:]' '[:lower:]')" == "tbd" ]]; then
        echo "Missing verify command for required host capability: $capability" >&2
        failures=$((failures + 1))
      fi
      if ! env_status_is_positive "$status"; then
        echo "Required host capability is not satisfied: $capability (status: ${status:-missing})." >&2
        failures=$((failures + 1))
      fi
    fi
  done < "$path"

  if [[ "$rows" -eq 0 ]]; then
    echo "No host requirements table rows found in .dev-flow/HOST_REQUIREMENTS.md" >&2
    failures=$((failures + 1))
  fi

  if [[ "$failures" -gt 0 ]]; then
    echo "Host environment check failed for $project with $failures issue(s)." >&2
    return 1
  fi

  echo "Host environment check passed for $project. No host SDKs were installed by this command."
}

ship_check_impl() {
  local project="$1"
  local phase failures
  failures=0
  for phase in idea pm agent spec design plan build test review ship; do
    if ! phase_is_applicable "$project" "$phase"; then
      echo "Skipping non-applicable phase: $project/$phase"
      continue
    fi
    if ! verify_phase_impl "$project" "$phase"; then
      failures=$((failures + 1))
    fi
  done
  if [[ "$failures" -gt 0 ]]; then
    echo "Ship check failed for $project with $failures failing phase(s)." >&2
    return 1
  fi
  if ! (cd "$(project_path "$project")" && ./bin/check); then
    echo "Project default check failed for $project." >&2
    return 1
  fi
  if ! env_check_impl "$project"; then
    echo "Project host environment check failed for $project." >&2
    return 1
  fi
  if phase_is_applicable "$project" design; then
    if ! qa_check_impl "$project"; then
      echo "Project QA check failed for $project." >&2
      return 1
    fi
  fi
  if ! pdca_check_impl "$project"; then
    echo "Project PDCA check failed for $project." >&2
    return 1
  fi
  echo "Ship check passed for $project."
}

doctor_check_impl() {
  local project="$1"
  local dir failures schema_file tracked_runtime
  require_project "$project"
  dir="$(project_path "$project")"
  schema_file="$dir/.dev-flow/schema.env"
  failures=0
  if [[ ! -f "$schema_file" ]]; then
    echo "Missing schema: .dev-flow/schema.env" >&2
    failures=$((failures + 1))
  else
    load_project_schema "$project"
    if [[ "$PROJECT_SCHEMA_VERSION" != "$DEV_FLOW_PROJECT_SCHEMA_VERSION" ]]; then
      echo "Outdated schema: PROJECT_SCHEMA_VERSION=$PROJECT_SCHEMA_VERSION, expected $DEV_FLOW_PROJECT_SCHEMA_VERSION" >&2
      failures=$((failures + 1))
    fi
    if ! dev_flow_valid_project_type "$PROJECT_TYPE"; then
      echo "Invalid schema project type: $PROJECT_TYPE" >&2
      failures=$((failures + 1))
    fi
  fi
  local dir_name
  for dir_name in ideas product agent specs design design/references design/drafts design/mocks design/screenshots design/sources design/sources/imagegen design/sources/gpt-image design/sources/figma design/sources/uploads design/sources/html design/approved design/approved/screens design/approved/components design/approved/html design/cut-assets design/cut-assets/icons design/cut-assets/sprites design/cut-assets/illustrations design/cut-assets/backgrounds tasks reviews reviews/visual-screenshots ship apps packages .dev-flow; do
    if [[ ! -d "$dir/$dir_name" ]]; then
      echo "Missing template directory: $dir_name" >&2
      failures=$((failures + 1))
    fi
  done
  local file_name
  for file_name in .dev-flow/state.env .dev-flow/applicability.env .dev-flow/context.md .dev-flow/HOST_REQUIREMENTS.md design/reference-intake.md design/reference-links.md design/REFERENCE_BOARD.md design/FIGMA_HANDOFF.md design/DESIGN_ARTIFACTS.md design/DESIGN_IMAGE_DESCRIPTIONS.md design/cut-assets/ASSET_MANIFEST.md tasks/status.md tasks/quality-gates.md tasks/PDCA.md tasks/IMPLEMENTATION_TRACE.md reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md reviews/VISUAL_COMPARISON.md bin/check; do
    if [[ ! -f "$dir/$file_name" ]]; then
      echo "Missing template file: $file_name" >&2
      failures=$((failures + 1))
    fi
  done
  if [[ -f "$dir/bin/check" && ! -x "$dir/bin/check" ]]; then
    echo "Project check is not executable: bin/check" >&2
    failures=$((failures + 1))
  fi
  tracked_runtime="$(git -C "$ROOT" ls-files "work/$project" "dist" ".codex" ".claude" ".gemini" ".openclaw" ".opencode" 2>/dev/null || true)"
  if [[ -n "$tracked_runtime" ]]; then
    echo "Tracked runtime/generated output found:" >&2
    printf '%s\n' "$tracked_runtime" >&2
    failures=$((failures + 1))
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Doctor found $failures issue(s) for $project. Run: bin/dev-flow migrate $project" >&2
    return 1
  fi
  echo "Doctor passed for $project."
}

migrate_project_impl() {
  local project="$1"
  local project_type="$2"
  local dir
  require_project "$project"
  dir="$(project_path "$project")"
  ensure_project_dirs "$dir"
  write_project_templates "$dir" "$project" "$project_type"
  write_project_schema_file "$project" "$project_type"
  echo "Migrated $project to schema v$DEV_FLOW_PROJECT_SCHEMA_VERSION ($project_type)."
}

copy_runtime_package() {
  local target="$1"
  mkdir -p "$target/bin" "$target/tests" "$target/agent-skills"
  cp "$ROOT/AGENTS.md" "$target/AGENTS.md"
  cp "$ROOT/DEV_FLOW.md" "$target/DEV_FLOW.md"
  cp "$ROOT/README.md" "$target/README.md"
  cp "$ROOT/LICENSE" "$target/LICENSE"
  cp "$PACK/dev-agent-opc.manifest.json" "$target/agent-skills/dev-agent-opc.manifest.json"
  cp "$ROOT/bin/dev-flow" "$target/bin/dev-flow"
  chmod +x "$target/bin/dev-flow"
  cp "$ROOT/tests/dev-flow-smoke.sh" "$target/tests/dev-flow-smoke.sh"
  chmod +x "$target/tests/dev-flow-smoke.sh"
  mkdir -p "$target/agent-skills/templates" "$target/agent-skills/lib"
  cp -R "$PACK/templates/." "$target/agent-skills/templates/"
  cp -R "$PACK/lib/." "$target/agent-skills/lib/"
  copy_skill_dirs "$target/agent-skills/skills"
  copy_agent_dirs "$target/agent-skills/agents"
  copy_command_dirs "$target/agent-skills/commands"
  copy_reference_dirs "$target/agent-skills"
  clean_metadata "$target"
}

copy_skill_dirs() {
  local target="$1"
  local skill_dir
  local name
  mkdir -p "$target"
  if [[ -d "$PACK/skills" ]]; then
    for skill_dir in "$PACK/skills"/*; do
      [[ -d "$skill_dir" ]] || continue
      name="$(basename "$skill_dir")"
      mkdir -p "$target/$name"
      cp -R "$skill_dir/." "$target/$name/"
    done
  fi
}

copy_agent_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/agents" ]]; then
    find "$PACK/agents" -mindepth 1 -maxdepth 1 -type f -name '*.md' -exec cp {} "$target" \;
  fi
}

copy_reference_dirs() {
  local target="$1"
  if [[ -d "$PACK/references" ]]; then
    mkdir -p "$target/references"
    cp -R "$PACK/references/." "$target/references/"
  fi
  if [[ -f "$PACK/dev-agent-opc.manifest.json" ]]; then
    cp "$PACK/dev-agent-opc.manifest.json" "$target/dev-agent-opc.manifest.json"
  fi
}

copy_command_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/commands" ]]; then
    cp -R "$PACK/commands/." "$target/"
  fi
}

copy_native_command_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/commands" ]]; then
    find "$PACK/commands" -maxdepth 1 -type f -name 'opc-*.md' -exec cp {} "$target" \;
  fi
}

copy_native_skill_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/native/skills/dev-agent-opc" ]]; then
    mkdir -p "$target/dev-agent-opc"
    cp -R "$PACK/native/skills/dev-agent-opc/." "$target/dev-agent-opc/"
  fi
}

clean_metadata() {
  local target="$1"
  [[ -d "$target" ]] || return 0
  find "$target" \( -name '.DS_Store' -o -name '@eaDir' -o -name '*SynoEAStream' -o -name '*SynoResource' \) -prune -exec rm -rf {} + 2>/dev/null || true
}

copy_claude_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.claude/commands" ]]; then
    cp -R "$PACK/.claude/commands/." "$target/"
  fi
}

copy_native_claude_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.claude/commands" ]]; then
    find "$PACK/.claude/commands" -maxdepth 1 -type f -name 'opc-*.md' -exec cp {} "$target" \;
  fi
}

copy_gemini_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.gemini/commands" ]]; then
    cp -R "$PACK/.gemini/commands/." "$target/"
  fi
}

copy_native_gemini_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.gemini/commands" ]]; then
    find "$PACK/.gemini/commands" -maxdepth 1 -type f -name 'opc-*.toml' -exec cp {} "$target" \;
  fi
}

embed_shared_references() {
  local skills_dir="$1"
  local skill_dir
  [[ -d "$skills_dir" && -d "$PACK/references" ]] || return 0
  for skill_dir in "$skills_dir"/*; do
    [[ -d "$skill_dir" ]] || continue
    mkdir -p "$skill_dir/references"
    cp -R "$PACK/references/." "$skill_dir/references/"
  done
}

skill_name() {
  case "${1:-}" in
    idea) echo "idea-refine" ;;
    spec) echo "spec-driven-development" ;;
    design) echo "design-flow" ;;
    plan) echo "planning-and-task-breakdown" ;;
    build) echo "incremental-implementation" ;;
    test) echo "test-driven-development" ;;
    review) echo "code-review-and-quality" ;;
    debug) echo "debugging-and-error-recovery" ;;
    ui) echo "frontend-ui-engineering" ;;
    api) echo "api-and-interface-design" ;;
    security) echo "security-and-hardening" ;;
    ship) echo "shipping-and-launch" ;;
    pm) echo "pm-flow" ;;
    agent) echo "agent-flow" ;;
    *) echo "${1:-}" ;;
  esac
}

normalize_target() {
  case "${1:-}" in
    claude|claude-code) echo "claude-code" ;;
    codex|gemini|openclaw|opencode) echo "${1:-}" ;;
    *) echo "" ;;
  esac
}

default_install_dest() {
  local target="$1"
  local scope="$2"
  case "$scope:$target" in
    project:codex) echo "$ROOT/.codex" ;;
    user:codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
    project:claude-code) echo "$ROOT/.claude" ;;
    user:claude-code) echo "$HOME/.claude" ;;
    project:gemini) echo "$ROOT/.gemini/extensions/dev-flow-quality" ;;
    user:gemini) echo "$HOME/.gemini/extensions/dev-flow-quality" ;;
    project:openclaw) echo "$ROOT/.openclaw" ;;
    user:openclaw) echo "$HOME/.openclaw" ;;
    project:opencode) echo "$ROOT/.opencode" ;;
    user:opencode) echo "$HOME/.config/opencode" ;;
    *) return 1 ;;
  esac
}

write_gemini_extension_manifest() {
  local target="$1"
  cat > "$target/gemini-extension.json" <<'EOF'
{
  "name": "dev-flow-quality",
  "version": "0.1.0",
  "description": "Agent skills and personas for lifecycle-driven software delivery",
  "contextFileName": "GEMINI.md",
  "plan": {
    "directory": ".gemini/plans"
  }
}
EOF
  cat > "$target/GEMINI.md" <<'EOF'
# Dev Flow Quality

Use the bundled skills for lifecycle-driven software delivery. For customer-facing UI, design-flow owns reference intake and screen acceptance; frontend-ui-engineering owns implementation, functional QA, monkey testing, and visual comparison.
EOF
}

install_adapter() {
  local target_raw="${1:-}"
  local target
  target="$(normalize_target "$target_raw")"
  if [[ -z "$target" ]]; then
    echo "Unknown install target: ${target_raw:-<missing>}" >&2
    echo "Targets: codex, claude-code, gemini, openclaw, opencode" >&2
    exit 1
  fi

  local scope="project"
  local dest=""
  local mode="native"
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --scope=*)
        scope="${1#--scope=}"
        shift
        ;;
      --dest)
        dest="${2:-}"
        shift 2
        ;;
      --dest=*)
        dest="${1#--dest=}"
        shift
        ;;
      --mode)
        mode="${2:-}"
        shift 2
        ;;
      --mode=*)
        mode="${1#--mode=}"
        shift
        ;;
      *)
        echo "Unknown install option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$scope" != "project" && "$scope" != "user" ]]; then
    echo "Invalid scope: $scope" >&2
    echo "Use --scope project or --scope user." >&2
    exit 1
  fi
  if [[ "$mode" != "native" && "$mode" != "full" ]]; then
    echo "Invalid install mode: $mode" >&2
    echo "Use --mode native or --mode full." >&2
    exit 1
  fi
  if [[ -z "$dest" ]]; then
    dest="$(default_install_dest "$target" "$scope")"
  fi

  case "$target" in
    codex)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
    claude-code)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_claude_commands "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_claude_commands "$dest/commands"
      fi
      ;;
    gemini)
      mkdir -p "$dest"
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_gemini_commands "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_gemini_commands "$dest/commands"
      fi
      write_gemini_extension_manifest "$dest"
      ;;
    openclaw)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
    opencode)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
  esac

  copy_runtime_package "$dest/dev-agent-opc-runtime"
  clean_metadata "$dest"
  echo "Installed $target adapter under $dest"
  echo "Scope: $scope"
  echo "Mode: $mode"
  echo "Runtime: $dest/dev-agent-opc-runtime"
}

remove_installed_path() {
  local path="$1"
  if [[ -e "$path" ]]; then
    rm -rf "$path"
    echo "Removed $path"
  fi
}

remove_matching_file() {
  local source="$1"
  local target="$2"
  if [[ ! -e "$target" ]]; then
    return 0
  fi
  if [[ -f "$source" && -f "$target" ]] && cmp -s "$source" "$target"; then
    rm -f "$target"
    echo "Removed $target"
  else
    echo "Skipped modified or unknown file: $target" >&2
  fi
}

remove_matching_dir_by_skill() {
  local source_dir="$1"
  local target_dir="$2"
  if [[ ! -d "$target_dir" ]]; then
    return 0
  fi
  if [[ -f "$source_dir/SKILL.md" && -f "$target_dir/SKILL.md" ]] && cmp -s "$source_dir/SKILL.md" "$target_dir/SKILL.md"; then
    rm -rf "$target_dir"
    echo "Removed $target_dir"
  else
    echo "Skipped modified or unknown skill dir: $target_dir" >&2
  fi
}

remove_dev_flow_files() {
  local target="$1"
  local command_source="$2"
  local command_ext="$3"
  local file
  local name

  if [[ -d "$PACK/skills" ]]; then
    for file in "$PACK/skills"/*; do
      [[ -d "$file" ]] || continue
      name="$(basename "$file")"
      remove_matching_dir_by_skill "$file" "$target/skills/$name"
    done
  fi
  remove_matching_dir_by_skill "$PACK/native/skills/dev-agent-opc" "$target/skills/dev-agent-opc"

  if [[ -d "$command_source" ]]; then
    for file in "$command_source"/*."$command_ext"; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/commands/$(basename "$file")"
    done
  fi

  if [[ -d "$PACK/agents" ]]; then
    for file in "$PACK/agents"/*.md; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/agents/$(basename "$file")"
    done
  fi

  if [[ -d "$PACK/references" ]]; then
    for file in "$PACK/references"/*.md; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/references/$(basename "$file")"
    done
  fi
  remove_matching_file "$PACK/dev-agent-opc.manifest.json" "$target/dev-agent-opc.manifest.json"
  remove_installed_path "$target/dev-agent-opc-runtime"
  rmdir "$target/skills" "$target/commands" "$target/agents" "$target/references" 2>/dev/null || true
}

uninstall_adapter() {
  local target_raw="${1:-}"
  local target
  target="$(normalize_target "$target_raw")"
  if [[ -z "$target" ]]; then
    echo "Unknown uninstall target: ${target_raw:-<missing>}" >&2
    echo "Targets: codex, claude-code, gemini, openclaw, opencode" >&2
    exit 1
  fi

  local scope="project"
  local dest=""
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --scope=*)
        scope="${1#--scope=}"
        shift
        ;;
      --dest)
        dest="${2:-}"
        shift 2
        ;;
      --dest=*)
        dest="${1#--dest=}"
        shift
        ;;
      *)
        echo "Unknown uninstall option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$scope" != "project" && "$scope" != "user" ]]; then
    echo "Invalid scope: $scope" >&2
    echo "Use --scope project or --scope user." >&2
    exit 1
  fi
  if [[ -z "$dest" ]]; then
    dest="$(default_install_dest "$target" "$scope")"
  fi

  case "$target" in
    claude-code)
      remove_dev_flow_files "$dest" "$PACK/.claude/commands" "md"
      ;;
    gemini)
      remove_dev_flow_files "$dest" "$PACK/.gemini/commands" "toml"
      remove_matching_file <(printf '%s\n' '{"name":"dev-flow-quality"}') "$dest/gemini-extension.json"
      ;;
    codex|openclaw|opencode)
      remove_dev_flow_files "$dest" "$PACK/commands" "md"
      ;;
  esac

  echo "Uninstalled $target adapter from $dest"
}

skill_path() {
  local name
  name="$(skill_name "${1:-}")"
  echo "$PACK/skills/$name/SKILL.md"
}

persona_name() {
  case "${1:-}" in
    opc-code-reviewer) echo "code-reviewer" ;;
    opc-product-designer) echo "product-designer" ;;
    opc-security-auditor) echo "security-auditor" ;;
    opc-test-engineer) echo "test-engineer" ;;
    opc-ui-quality-reviewer) echo "ui-quality-reviewer" ;;
    *) echo "${1:-}" ;;
  esac
}

persona_path() {
  local name
  name="$(persona_name "${1:-}")"
  echo "$PACK/agents/$name.md"
}

require_pack() {
  if [[ ! -d "$PACK" ]]; then
    echo "Missing $PACK. Restore the canonical agent-skills/ directory before running dev-flow." >&2
    exit 1
  fi
  if [[ ! -d "$TEMPLATES" ]]; then
    echo "Missing $TEMPLATES. Restore agent-skills/templates/project before running dev-flow." >&2
    exit 1
  fi
  if [[ ! -d "$LIB" ]] || ! command -v dev_flow_valid_project_type >/dev/null 2>&1 || ! command -v dev_flow_write_template_if_missing >/dev/null 2>&1; then
    echo "Missing dev-flow library modules under $LIB." >&2
    exit 1
  fi
}

cmd="${1:-help}"
require_pack

case "$cmd" in
  list)
    find "$PACK/skills" -mindepth 2 -maxdepth 2 -name SKILL.md \
      | sed "s#^$PACK/skills/##; s#/SKILL.md\$##" \
      | sort -u
    ;;
  manifest)
    path="$PACK/dev-agent-opc.manifest.json"
    if [[ ! -f "$path" ]]; then
      echo "Missing manifest: $path" >&2
      exit 1
    fi
    cat "$path"
    ;;
  show)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  path)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    echo "$path"
    ;;
  command)
    name="${2:-}"
    path="$PACK/commands/$name.md"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown command: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  agent)
    name="${2:-}"
    path="$(persona_path "$name")"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown agent persona: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  install)
    install_adapter "${2:-}" "${@:3}"
    ;;
  uninstall)
    uninstall_adapter "${2:-}" "${@:3}"
    ;;
  refs)
    find "$PACK/references" -maxdepth 1 -type f -name '*.md' | sort
    ;;
  init)
    project="${2:-}"
    shift 2 || true
    project_type="$(project_type_from_options "$@")"
    dir="$(project_path "$project")"
    ensure_project_dirs "$dir"
    write_project_templates "$dir" "$project" "$project_type"
    write_if_missing "$dir/.dev-flow/state.env" "PROJECT_NAME=\"$project\"
CURRENT_PHASE=\"idea\"
CURRENT_TASK=\"Refine the initial idea\"
BLOCKERS=\"none\"
LAST_VERIFICATION=\"not run\""
    write_if_missing "$dir/.dev-flow/applicability.env" "# Phase applicability for $project
# Values: auto, required, delegated, disabled
#
# auto: validate this phase only after matching artifacts exist
# required: treat this phase as part of phase transitions and ship-check
# delegated: treat visual direction as user-delegated when used with UI_REFERENCES
# disabled: skip this phase in phase transitions and ship-check
PM_FLOW=\"auto\"
AGENT_FLOW=\"auto\"
UI_FLOW=\"required\"
UI_REFERENCES=\"required\"
UI_DESIGN_ASSETS=\"required\"
UI_FIGMA_HANDOFF=\"auto\"
UI_MOCKUPS=\"auto\"
GIT_CHECKPOINTS=\"auto\""
    write_if_missing "$dir/.dev-flow/context.md" "# Context Loading: $project

Load only the files needed for the current phase.

- Idea: read \`ideas/\` and relevant user notes.
- Product: read \`product/\` only when PM_FLOW is required or product artifacts exist.
- Agent: read \`agent/\` only when AGENT_FLOW is required or agent artifacts exist.
- Spec: read approved idea/product/agent artifacts that apply, and existing app files if present.
- Design: read \`specs/SPEC.md\`, \`design/reference-intake.md\`, \`design/DESIGN_ARTIFACTS.md\`, \`design/DESIGN_IMAGE_DESCRIPTIONS.md\`, \`design/FIGMA_HANDOFF.md\`, user-provided references, existing screens, and platform constraints.
- Plan: read approved spec/design and inspect likely source boundaries.
- Build: read the assigned task, approved design docs, \`design/approved/\` layout/state assets, \`design/approved/html/\` semantic companions when AI-generated images are used, \`design/FIGMA_HANDOFF.md\` when Figma is used, cut-asset manifest, implementation trace, nearby source files, and tests.
- PDCA: keep \`tasks/PDCA.md\` current across Current Cycle, Plan, Do, Check, and Act so decisions and evidence survive handoffs.
- Review: read the diff, tests, and quality-gate output.
- QA: after the current planned UI implementation batch is complete or explicitly blocked, read verification evidence, functional and monkey test logs, visual comparison score, and exception screenshots only when a flow is blocked.
- Ship: read review results, QA evidence, verification evidence, and launch notes.

Do not bulk-load \`agent-skills/\` or unrelated project folders."
    write_if_missing "$dir/design/reference-intake.md" "# Reference Intake: $project

Use this before customer-facing UI design or visual polish.

## Reference Assets
- Put screenshots, reference images, Figma exports, mood boards, or product captures in:
  - \`design/references/\`
  - \`design/screenshots/\`

## Draft Assets
- Put sketches, wireframes, SVG drafts, low-fidelity prototypes, local HTML/CSS mock screenshots, and files named draft/sketch/prototype under:
  - \`design/drafts/\`
  - \`design/mocks/\`

## Approved Design Assets
- Put implementation-ready design boards and exports only under:
  - \`design/approved/\`
- Follow the formal source contract in \`agent-skills/references/design-artifacts.md\`.
- Keep browser/simulator/runtime screenshots, HTML/CSS mock captures, and SVG layout sketches out of \`design/approved/\`.

## Figma Handoff
- After approved imagegen/GPT Image assets exist, record frame, component, or library handoff details in \`design/FIGMA_HANDOFF.md\` when Figma formalizes them.
- Export approved Figma frames or component boards to \`design/approved/\` and record them in \`DESIGN_ARTIFACTS.md\` with Source type \`figma\` or \`figma-mcp\`.

## Reference Software
- Put product names, app store links, websites, Figma links, or competitor notes in \`design/reference-links.md\`.

## Decision
- If reference assets or software are provided, extract visual patterns before designing: layout density, navigation model, component style, spacing, typography, color, motion, and tone.
- If this is customer-facing UI and no reference is provided, ask the user for examples unless the user has explicitly delegated visual direction.
- If the user delegates visual direction, create a short reference board first and save it under \`design/\` before implementation planning."
    write_if_missing "$dir/design/DESIGN.md" "# Design: $project

## UX Problem

## Recommended Direction

## Alternatives Considered

## Information Architecture

## Interaction Model

## Visual System

## Design Artifacts

## Build Implications
"
    write_if_missing "$dir/design/VISUAL_SYSTEM.md" "# Visual System: $project

## Reference Influence

## Palette

## Typography

## Spacing and Layout

## Components and Motion

## Forbidden Patterns
"
    write_if_missing "$dir/design/SCREEN_ACCEPTANCE.md" "# Screen Acceptance: $project

## [Screen Name]
- Required content:
- Required states:
- Breakpoints:
- Required design assets:
- Visual acceptance:
- Accessibility acceptance:
"
    write_if_missing "$dir/design/DESIGN_ARTIFACTS.md" "# Design Artifacts: $project

Use formal design assets before implementation planning for every customer-facing UI screen.

## Asset Classes
- Drafts: sketches, SVG/Mermaid/Markdown wireframes, low-fidelity prototypes, local HTML/CSS mock screenshots, files named draft/sketch/prototype. Save under \`design/drafts/\` or \`design/mocks/\`. Drafts are forbidden as implementation targets.
- Approved assets: high-fidelity raster/PDF/Figma exports from formal producers only. Save under \`design/approved/\`.
- AI image HTML descriptions: save semantic companions under \`design/approved/html/\` and record them in \`design/DESIGN_IMAGE_DESCRIPTIONS.md\`.
- Verification assets: browser screenshots, simulator captures, Playwright/Chrome captures, and runtime app output. Save under \`reviews/visual-screenshots/\` only when an exception or blocked flow needs evidence.
- Figma handoff: record file/node and export mappings in \`design/FIGMA_HANDOFF.md\` when used.

## Required Coverage
- Derive the canonical screen list from the PRD/spec/design/interaction model and record every required screen as a \`##\` section in \`SCREEN_ACCEPTANCE.md\`.
- Produce or collect 1-N approved layout/state assets for each \`SCREEN_ACCEPTANCE.md\` screen.
- Add at least one Screen Coverage row for each exact \`SCREEN_ACCEPTANCE.md\` screen heading.
- Follow \`agent-skills/references/design-artifacts.md\` for allowed source types, SVG/cut-asset rules, AI-image HTML companions, and Figma handoff.
- Run \`bin/dev-flow design-check $project\` before planning or build.

## Screen Coverage
| Screen | State | Source type | Source reference | Approved asset path | Resolution / export | Status | Implementation notes |
|---|---|---|---|---|---|---|---|
"
    write_if_missing "$dir/design/DESIGN_IMAGE_DESCRIPTIONS.md" "# Design Image HTML Descriptions: $project

When an approved design asset is generated by imagegen, GPT Image, or another AI image model, generate an HTML companion at the same time.

## Rules
- Save implementation-ready HTML companions under \`design/approved/html/\`.
- Store provider/source originals or rough HTML notes under \`design/sources/html/\`.
- Each AI-generated \`DESIGN_ARTIFACTS.md\` row must include the companion path in \`Implementation notes\`, for example \`HTML: design/approved/html/dashboard.html\`.
- The companion HTML should describe layout, hierarchy, content, components, states, colors, spacing, typography, interactions, and implementation notes.

## Description Coverage
| Screen | State | Source image | HTML description | Status | Notes |
|---|---|---|---|---|---|
"
write_if_missing "$dir/design/cut-assets/ASSET_MANIFEST.md" "# Cut Assets: $project

List SVG icons, bitmap icons, illustrations, UI cutouts, icon matrices, spritesheets, or animation frames cut from approved design assets when implementation needs them.
If no cut assets are required, record \`CUT_ASSETS_REQUIRED: no\` with a short rationale.

## Decision
- CUT_ASSETS_REQUIRED: TBD

## Asset Manifest
| Asset | Source approved asset | Source region / frame | Output path | Format | Alpha | Runtime path | Usage | Notes |
|---|---|---|---|---|---|---|---|---|

## Sprite / Matrix Rules
- Transparent PNG assets must preserve alpha.
- SVG files are allowed here only as element/runtime assets, not as screen layout references.
- Icon matrices and spritesheets must record grid, frame size, frame order, anchor point, scale, and intended FPS or state mapping.
- Do not cut assets from drafts, browser screenshots, simulator captures, or runtime screenshots.
"
    write_if_missing "$dir/design/reference-links.md" "# Reference Links: $project

Add user-provided reference apps, websites, Figma links, screenshots descriptions, or competitor notes below.

	## References"
    write_if_missing "$dir/design/FIGMA_HANDOFF.md" "# Figma Handoff: $project

Use this after approved imagegen/GPT Image high-fidelity assets are formalized
into Figma screens, components, or a design-system library before implementation.

## Decision
- FIGMA_HANDOFF_REQUIRED: auto
- Flow: reference/spec direction -> imagegen/GPT Image approved raster/PDF -> semantic HTML companion -> Figma frame/component/library -> exported approved asset under \`design/approved/\`
- Draft warning: HTML/CSS mock captures and Figma frames created from those captures are reference drafts only, not approved design sources.
- Library required: no
- Rationale:

## Figma Sources
| Screen | Figma source | Approved export | Role | Status | Notes |
|---|---|---|---|---|---|

## Source Inputs
| Input | Source path or URL | Used for | Notes |
|---|---|---|---|

## Export Rules
- Export implementation-ready screen/state frames as PNG or PDF under \`design/approved/screens/\`.
- Export component boards or component-set snapshots under \`design/approved/components/\`.
- Record every Figma-backed approved export in \`DESIGN_ARTIFACTS.md\` with \`Source type\` set to \`figma\` or \`figma-mcp\`.
- Keep drafts, running-app screenshots, browser screenshots, simulator screenshots, local HTML/CSS mock captures, and Figma frames created from those captures out of \`design/approved/\`."
    write_if_missing "$dir/tasks/status.md" "# Project Status: $project

## Current State
- Phase: idea
- Current task: Refine the initial idea
- Blockers: none
- Last verification: not run

## Phase Checklist
- [ ] Idea approved
- [ ] Spec approved
- [ ] Design approved
- [ ] Plan approved
- [ ] Build slices complete
- [ ] Tests and quality gates pass
- [ ] Review complete
- [ ] Ship package ready

## Human Review Gates
- Requirement confirmation
- Customer-facing visual direction when no reference image/software is provided
- High-risk architecture decisions
- Security, payment, permissions, or data deletion behavior
- Production launch approval"
    write_if_missing "$dir/tasks/quality-gates.md" "# Quality Gates: $project

Project-specific verification belongs here. Keep commands runnable from this project
folder and mirror them in \`bin/check\` when they become stable.

## Default Gate
- [ ] Required workflow folders exist
- [ ] Status ledger exists
- [ ] Context loading guidance exists
- [ ] Reference intake exists for customer-facing UI work
- [ ] Approved design assets exist under \`design/approved/\` before UI implementation
- [ ] \`bin/dev-flow design-check $project\` passes before UI implementation, when UI applies
- [ ] \`tasks/IMPLEMENTATION_TRACE.md\` maps required UI screens to implementation targets and evidence, when UI applies

## Add When The Project Has Code
- [ ] Lint
- [ ] Type check
- [ ] Unit tests
- [ ] Build
- [ ] Browser or device smoke test, when user-facing
- [ ] Functional flow test, when user-facing
- [ ] Monkey or exploratory stress test, when user-facing
- [ ] Current planned UI implementation batch is complete or explicitly blocked before visual comparison, when user-facing
- [ ] Visual comparison score is at least 90/100 against approved design assets, when user-facing
- [ ] \`tasks/PDCA.md\` records Current Cycle, Plan, Do, Check, and Act evidence for the current cycle
- [ ] \`bin/dev-flow pdca-check $project\`, before delivery
- [ ] \`bin/dev-flow design-check $project\`, before implementation planning for customer-facing UI
- [ ] \`bin/dev-flow qa-check $project\`, before delivery for customer-facing UI"
    write_if_missing "$dir/tasks/PDCA.md" "# PDCA: $project

Use this as the handoff ledger for each delivery cycle. Keep each section current
instead of reconstructing decisions at release time.

## Current Cycle
- Cycle ID:
- Scope:
- Owner / agent:
- Started:
- Checkpoint:

## Plan
- Objective:
- Source artifacts: ideas/idea-brief.md, specs/SPEC.md, design/DESIGN.md when UI applies, tasks/PLAN.md
- Acceptance evidence:
- Quality gates:

## Do
- Implementation slices:
- Changed areas:
- Build artifacts:

## Check
- Verification evidence:
- Functional test evidence:
- Monkey test evidence:
- UI batch completion before visual acceptance, when applicable:
- UI visual comparison evidence, when applicable:

## Act
- Decision:
- Standardize:
- Iterate / follow-up:
- Rollback or recovery notes:
"
    write_if_missing "$dir/reviews/FUNCTIONAL_TEST.md" "# Functional Test: $project

Record normal happy-path and critical user-flow verification here after implementation.

## Commands / Devices

## Flows Checked

## Result
"
    write_if_missing "$dir/reviews/MONKEY_TEST.md" "# Monkey Test: $project

Record random, exploratory, stress, or resilience testing here after implementation.

## Scope

## Events / Inputs

## Result
"
    write_if_missing "$dir/reviews/VISUAL_COMPARISON.md" "# Visual Comparison: $project

Compare the implemented UI with approved design assets and derived cut assets.

Overall score: 0/100

## Compared Inputs
- Approved design assets:
- Cut assets:
- Runtime UI surfaces:
- Exception screenshots, only if a flow was blocked:

## Screen Fidelity Matrix
| Screen | Approved asset path | Runtime surface | Fidelity score | Notes |
|---|---|---|---|---|

## Score Breakdown
- Layout and hierarchy:
- Component fidelity:
- State coverage:
- Responsiveness:
- Polish:

## Differences
-

## Decision
"
    write_if_missing "$dir/bin/check" "#!/usr/bin/env bash
set -euo pipefail

ROOT=\"\$(cd \"\$(dirname \"\${BASH_SOURCE[0]}\")/..\" && pwd)\"

required_dirs=(ideas product agent specs design design/references design/drafts design/mocks design/screenshots design/sources design/sources/imagegen design/sources/gpt-image design/sources/figma design/sources/uploads design/sources/html design/approved design/approved/screens design/approved/components design/approved/html design/cut-assets tasks reviews reviews/visual-screenshots ship apps packages .dev-flow)
for d in \"\${required_dirs[@]}\"; do
  [[ -d \"\$ROOT/\$d\" ]] || { echo \"Missing directory: \$d\" >&2; exit 1; }
done

required_files=(.dev-flow/state.env .dev-flow/schema.env .dev-flow/context.md .dev-flow/HOST_REQUIREMENTS.md design/reference-intake.md design/reference-links.md design/REFERENCE_BOARD.md design/FIGMA_HANDOFF.md design/DESIGN_ARTIFACTS.md design/DESIGN_IMAGE_DESCRIPTIONS.md design/cut-assets/ASSET_MANIFEST.md tasks/status.md tasks/quality-gates.md tasks/PDCA.md tasks/IMPLEMENTATION_TRACE.md reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md reviews/VISUAL_COMPARISON.md)
for f in \"\${required_files[@]}\"; do
  [[ -f \"\$ROOT/\$f\" ]] || { echo \"Missing file: \$f\" >&2; exit 1; }
done

[[ -f \"\$ROOT/.dev-flow/applicability.env\" ]] || { echo \"Missing file: .dev-flow/applicability.env\" >&2; exit 1; }

echo \"Default workflow gate passed for \$(basename \"\$ROOT\").\""
    chmod +x "$dir/bin/check"
    echo "Initialized $dir"
    echo "Next: bin/dev-flow next $project"
    ;;
  status)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    load_project_state "$project"
    echo "Project: $project"
    echo "Path: $dir"
    echo "Phase: $CURRENT_PHASE"
    echo "Current task: $CURRENT_TASK"
    echo "Blockers: $BLOCKERS"
    echo "Last verification: $LAST_VERIFICATION"
    echo
    echo "Artifacts:"
    find "$dir" -maxdepth 4 -type f \
      | sed "s#^$dir/##" \
      | sort
    ;;
  phase)
    project="${2:-}"
    phase="${3:-}"
    task=""
    force="false"
    shift 3 || true
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --force) force="true"; shift ;;
        *)
          if [[ -z "$task" ]]; then task="$1"; else task="$task $1"; fi
          shift
          ;;
      esac
    done
    require_project "$project"
    if ! is_valid_phase "$phase"; then
      echo "Invalid phase: ${phase:-<missing>}" >&2
      echo "Valid phases: idea, pm, agent, spec, design, plan, build, test, review, ship" >&2
      exit 1
    fi
    if [[ "$force" != "true" ]]; then
      verify_prior_applicable_phases "$project" "$phase"
    fi
    load_project_state "$project"
    if [[ -z "$task" ]]; then
      task="$CURRENT_TASK"
    fi
    write_project_state "$project" "$phase" "$task" "$BLOCKERS" "$LAST_VERIFICATION"
    dir="$(project_path "$project")"
    {
      echo
      echo "## Update $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      echo "- Phase: $phase"
      echo "- Current task: $task"
    } >> "$dir/tasks/status.md"
    echo "Updated $project to phase: $phase"
    echo "Next: bin/dev-flow next $project"
    ;;
  next)
    project="${2:-}"
    require_project "$project"
    load_project_state "$project"
    load_project_schema "$project"
    echo "Project: $project"
    echo "Type: $PROJECT_TYPE"
    echo "Current phase: $CURRENT_PHASE"
    echo "Current task: $CURRENT_TASK"
    echo "Blockers: $BLOCKERS"
    echo
    next_prompt_for_phase "$project" "$CURRENT_PHASE"
    ;;
  verify-phase)
    project="${2:-}"
    phase="${3:-}"
    verify_phase_impl "$project" "$phase"
    record_verification "$project" "verify-phase:$phase passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  ship-check)
    project="${2:-}"
    ship_check_impl "$project"
    record_verification "$project" "ship-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  pdca-check)
    project="${2:-}"
    pdca_check_impl "$project"
    record_verification "$project" "pdca-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  env-check)
    project="${2:-}"
    env_check_impl "$project"
    record_verification "$project" "env-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  doctor)
    project="${2:-}"
    doctor_check_impl "$project"
    ;;
  migrate)
    project="${2:-}"
    shift 2 || true
    project_type="$(project_type_from_options "$@")"
    migrate_project_impl "$project" "$project_type"
    ;;
  reference-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    load_project_applicability "$project"
    if [[ "$mode" == "--delegated" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    assets="$(count_reference_assets "$dir")"
    links="$(count_reference_links "$dir")"
    total=$((assets + links))
    echo "Project: $project"
    echo "Reference assets: $assets"
    echo "Reference links/software notes: $links"
    if ! references_required_loaded; then
      echo "Reference intake passed by project applicability: UI_REFERENCES=$UI_REFERENCES."
      echo "Record the delegated visual direction in DESIGN.md and approve formal design assets before implementation."
      exit 0
    fi
    if [[ "$total" -gt 0 ]]; then
      echo "Reference intake passed."
      echo "Use these references in design requirements and visual comparison QA."
      exit 0
    fi
    echo "No reference assets or reference software found."
    echo "For customer-facing UI, ask the user for reference images, screenshots, Figma links, app names, or websites before design."
    echo "If the user delegates visual direction, create a reference board under work/$project/design/ before implementation planning."
    if [[ "$mode" == "--required" ]]; then
      exit 1
    fi
    ;;
  asset-check)
    project="${2:-}"
    asset_check_impl "$project"
    record_verification "$project" "asset-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  figma-check)
    project="${2:-}"
    figma_check_impl "$project"
    record_verification "$project" "figma-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  design-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    failures=0
    design_assets="$(count_approved_design_artifacts "$dir")"
    final_design_assets="$(count_final_design_artifacts "$dir")"
    load_project_applicability "$project"
    if [[ "$mode" == "--allow-no-reference" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    if references_required_loaded; then
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      if [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or set UI_REFERENCES=\"delegated\" after the user explicitly delegates visual direction." >&2
        failures=$((failures + 1))
      fi
    fi
    if setting_delegated "$UI_REFERENCES" && ! delegated_reference_board_present "$dir"; then
      echo "Missing delegated reference board: create design/REFERENCE_BOARD.md before using delegated visual direction." >&2
      failures=$((failures + 1))
    fi
    if setting_enabled "$UI_DESIGN_ASSETS"; then
      asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
    fi
    if setting_enabled "$UI_FIGMA_HANDOFF" || [[ "$(count_figma_design_artifact_rows "$dir")" -gt 0 ]]; then
      figma_check_impl "$project" >/dev/null || failures=$((failures + 1))
    fi
    for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
      if ! has_content "$dir/$file"; then
        echo "Missing or too thin: $file" >&2
        failures=$((failures + 1))
      fi
    done
    if ! check_design_package_structure "$dir"; then
      failures=$((failures + 1))
    fi
    if [[ "$failures" -gt 0 ]]; then
      echo "Design check failed for $project." >&2
      exit 1
    fi
    echo "Design check passed for $project with $design_assets approved design asset(s), including $final_design_assets final raster/PDF board(s), covering every SCREEN_ACCEPTANCE screen."
    ;;
  qa-check|visual-check)
    project="${2:-}"
    qa_check_impl "$project"
    ;;
  check)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    if [[ ! -x "$dir/bin/check" ]]; then
      echo "Missing executable quality gate: $dir/bin/check" >&2
      exit 1
    fi
    (cd "$dir" && ./bin/check)
    ;;
  package-adapters)
    out="${2:-dist/dev-flow-native}"
    if [[ -e "$out" ]]; then
      echo "Output already exists: $out" >&2
      echo "Choose a new output directory." >&2
      exit 1
    fi
    mkdir -p "$out"

    copy_skill_dirs "$out/codex/skills"
    copy_agent_dirs "$out/codex/agents"
    copy_reference_dirs "$out/codex"
    copy_command_dirs "$out/codex/commands"
    embed_shared_references "$out/codex/skills"

    copy_skill_dirs "$out/claude-code/skills"
    copy_agent_dirs "$out/claude-code/agents"
    copy_reference_dirs "$out/claude-code"
    embed_shared_references "$out/claude-code/skills"
    copy_claude_commands "$out/claude-code/.claude/commands"

    mkdir -p "$out/gemini/dev-flow-quality"
    copy_skill_dirs "$out/gemini/dev-flow-quality/skills"
    copy_agent_dirs "$out/gemini/dev-flow-quality/agents"
    copy_reference_dirs "$out/gemini/dev-flow-quality"
    embed_shared_references "$out/gemini/dev-flow-quality/skills"
    copy_gemini_commands "$out/gemini/dev-flow-quality/commands"
    write_gemini_extension_manifest "$out/gemini/dev-flow-quality"

    copy_skill_dirs "$out/openclaw/skills"
    copy_agent_dirs "$out/openclaw/agents"
    copy_reference_dirs "$out/openclaw"
    copy_command_dirs "$out/openclaw/commands"
    embed_shared_references "$out/openclaw/skills"

    copy_skill_dirs "$out/opencode/.opencode/skills"
    copy_agent_dirs "$out/opencode/.opencode/agents"
    copy_reference_dirs "$out/opencode/.opencode"
    copy_command_dirs "$out/opencode/.opencode/commands"
    embed_shared_references "$out/opencode/.opencode/skills"

    copy_runtime_package "$out/runtime"

    cat > "$out/INSTALL.md" <<'EOF'
# Agent Skills Native Adapter Package

Install the generated folders into the target agent surface. There are two layers:

- Rules prompt layer: install `skills/`, `commands/`, `agents/`, and `references/` into the target agent host.
- Runtime gate layer: use `runtime/` when you also need executable `bin/dev-flow` gates, project templates, `doctor`, `migrate`, `env-check`, `asset-check`, smoke tests, and adapter packaging.

- Codex App/CLI: copy `codex/skills/*` to `~/.codex/skills/`. `codex/commands/` contains reusable prompt shortcuts for hosts that support custom commands or snippets.
- Claude Code: copy `claude-code/skills/*` to `~/.claude/skills/` or project `.claude/skills/`; copy `.claude/commands/` into a project when slash commands are desired.
- Claude.ai/API: upload or package each skill folder separately for that surface.
- Gemini CLI: run `gemini extensions link <path-to>/gemini/dev-flow-quality` while developing, or `gemini extensions install <path-to>/gemini/dev-flow-quality`.
- OpenClaw: copy `openclaw/skills/*` to `~/.openclaw/skills/`, `~/.agents/skills/`, or workspace `skills/`; use `openclaw/commands/` as command snippets where supported.
- OpenCode: copy `opencode/.opencode/skills/*` into a workspace `.opencode/skills/`, or copy to `~/.config/opencode/skills/`; copy `.opencode/commands/` where supported.

Agent personas are included under each adapter's `agents/` directory when the platform supports persona/sub-agent files. Shared references are embedded into each packaged skill so standalone skill installation keeps reference files available.

The `runtime/` folder is a self-contained workflow-pack checkout surface. Copy or clone it when a platform user needs the same machine-checkable gates used by this repository. It intentionally excludes `work/`, checked-in `dist/`, local host adapter installs, and host-level SDKs. Host SDKs and permissions belong in each project's `.dev-flow/HOST_REQUIREMENTS.md` contract, not inside `work/<project>/`.

The helper can also install directly:

```bash
bin/dev-flow install codex --scope user
bin/dev-flow install claude-code --scope project
bin/dev-flow install gemini --scope project
bin/dev-flow install openclaw --scope user
bin/dev-flow install opencode --scope project
```

Direct installs default to native mode: one `dev-agent-opc` top-level skill,
`opc-*` commands, and a `dev-agent-opc-runtime/` folder under the destination.
Use `--mode full` to install every internal workflow skill as a top-level skill.
Uninstall with `bin/dev-flow uninstall <target> --scope <project|user>`.
EOF
    clean_metadata "$out"
    echo "Packaged adapters under $out"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
